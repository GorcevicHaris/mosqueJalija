---
// NBS IPS QR kod za uplatu (donaciju) — generiše se u pregledaču, bez biblioteka i bez slanja podataka.
// UGOVOR: props { racun: string | null; primalac: string | null; svrha?: string | null }
//   (opciono: sifraPlacanja — podrazumijevano '289' „transakcije po nalogu građana”; pozivNaBroj).
// racun === null → Placeholder „Broj računa nije objavljen”. Upotreba na /donacije:
//   <IpsQr racun={dzamija.donacije.racun} primalac={dzamija.donacije.primalac} svrha={dzamija.donacije.svrha} />
import Placeholder from '../ui/Placeholder.astro';
import { formatirajRacun, normalizujRacun, ocistiTekst, racunIspravan } from '../../lib/alati/ips';

interface Props {
  racun: string | null;
  primalac: string | null;
  svrha?: string | null;
  sifraPlacanja?: string;
  pozivNaBroj?: string | null;
}
const { racun, primalac, svrha = null, sifraPlacanja = '289', pozivNaBroj = null } = Astro.props;
const r18 = racun ? normalizujRacun(racun) : null;
const racunOk = !!r18 && racunIspravan(r18);
const naziv = primalac ? ocistiTekst(primalac, true) : '';
const svrhaPocetna = ocistiTekst(svrha ?? 'Dobrovoljni prilog za džamiju').slice(0, 35);
const uid = `ips-${Math.random().toString(36).slice(2, 8)}`;
const iznosi = [500, 1000, 2000, 5000];
---
{racun === null ? (
  <Placeholder label="Broj računa nije objavljen" hint="QR kod za uplatu biće prikazan kada džemat objavi račun" />
) : !racunOk ? (
  <Placeholder label="broj računa nije ispravan" hint="provjerite 18 cifara i kontrolni broj (model 97)" />
) : !naziv ? (
  <Placeholder label="naziv primaoca uplate" hint="obavezan je za IPS QR kod" />
) : (
  <div class="ips card" data-ips-qr data-racun={r18} data-primalac={naziv} data-sf={sifraPlacanja} data-ro={pozivNaBroj ?? ''}>
    <div class="ips__form">
      <h3 class="ips__h">Uplata skeniranjem (IPS QR)</h3>
      <div class="field">
        <label for={`${uid}-iznos`}>Iznos (RSD)</label>
        <input id={`${uid}-iznos`} class="input ips__iznos" type="text" inputmode="decimal" autocomplete="off" placeholder="npr. 1000" data-ips-iznos aria-describedby={`${uid}-greska`} />
      </div>
      <div class="ips__quick" role="group" aria-label="Brzi izbor iznosa">
        {iznosi.map((n) => <button type="button" class="chip" data-ips-brzo={n}>{n.toLocaleString('sr-Latn-RS')}</button>)}
      </div>
      <div class="field">
        <label for={`${uid}-svrha`}>Svrha uplate</label>
        <input id={`${uid}-svrha`} class="input" type="text" maxlength="35" value={svrhaPocetna} data-ips-svrha />
      </div>
      <dl class="ips__dl">
        <div><dt>Primalac</dt><dd>{naziv.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</dd></div>
        <div><dt>Račun</dt><dd class="ips__mono">{formatirajRacun(r18!)}</dd></div>
        <div><dt>Šifra plaćanja</dt><dd>{sifraPlacanja}</dd></div>
      </dl>
    </div>
    <div class="ips__qr">
      <div class="ips__box" data-ips-box aria-live="polite">
        <p class="ips__empty" data-ips-empty>Unesite iznos da biste dobili QR kod.</p>
      </div>
      <p class="ips__err" id={`${uid}-greska`} data-ips-greska role="alert"></p>
      <p class="ips__how">
        Otvorite aplikaciju svoje banke, izaberite <strong>IPS skeniraj</strong> (ili „Plati QR kodom”) i skenirajte kod.
        Prije potvrde provjerite primaoca i iznos. Kod se pravi u vašem pregledaču i ništa se ne šalje.
      </p>
    </div>
  </div>
)}

<style>
  .ips { display: grid; gap: var(--space-5); }
  @media (min-width: 720px) { .ips { grid-template-columns: 1fr minmax(220px, 280px); align-items: start; } }
  .ips__form { display: grid; gap: var(--space-4); }
  .ips__h { font-size: 1.2rem; margin: 0; }
  .ips__quick { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .ips__dl { margin: 0; display: grid; gap: 0; font-size: 0.92rem; }
  .ips__dl div { display: flex; justify-content: space-between; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); }
  .ips__dl dt { color: var(--color-text-muted); }
  .ips__dl dd { margin: 0; text-align: right; font-weight: 600; }
  .ips__mono { font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .ips__qr { display: grid; gap: var(--space-3); justify-items: center; }
  .ips__box {
    width: min(100%, 260px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: #fff;
    color: #000;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    padding: 0;
    overflow: hidden;
  }
  .ips__box :global(svg) { width: 100%; height: 100%; display: block; }
  .ips__empty { margin: 0; padding: var(--space-4); text-align: center; color: #56635b; font-size: 0.92rem; }
  .ips__err { min-height: 1.4em; margin: 0; color: var(--color-danger); font-size: 0.88rem; font-weight: 600; text-align: center; }
  .ips__how { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; }
</style>

<script>
  import { napraviIpsTekst } from '../../lib/alati/ips.ts';
  import { qrMatrica, qrSvg } from '../../lib/alati/qr.ts';

  function broj(s: string): number | null {
    let t = s.replace(/[\s ']/g, '');
    if (!t) return null;
    if (t.includes(',')) t = t.replace(/\./g, '').replace(',', '.');
    else if (/^\d{1,3}(\.\d{3})+$/.test(t)) t = t.replace(/\./g, '');
    const x = Number(t);
    return Number.isFinite(x) ? x : NaN;
  }

  document.querySelectorAll<HTMLElement>('[data-ips-qr]').forEach((root) => {
    const iznos = root.querySelector<HTMLInputElement>('[data-ips-iznos]')!;
    const svrha = root.querySelector<HTMLInputElement>('[data-ips-svrha]')!;
    const box = root.querySelector<HTMLElement>('[data-ips-box]')!;
    const empty = root.querySelector<HTMLElement>('[data-ips-empty]')!;
    const greska = root.querySelector<HTMLElement>('[data-ips-greska]')!;

    function osvjezi() {
      const a = broj(iznos.value);
      greska.textContent = '';
      if (a === null) {
        box.replaceChildren(empty);
        iznos.removeAttribute('aria-invalid');
        return;
      }
      const r = napraviIpsTekst({
        racun: root.dataset.racun ?? '',
        primalac: root.dataset.primalac ?? '',
        iznos: Number.isNaN(a) ? null : a,
        sifraPlacanja: root.dataset.sf,
        svrha: svrha.value,
        pozivNaBroj: root.dataset.ro || null,
      });
      if (!r.ok) {
        greska.textContent = r.greske.join(' ');
        iznos.setAttribute('aria-invalid', 'true');
        box.replaceChildren(empty);
        return;
      }
      iznos.removeAttribute('aria-invalid');
      const iznosTxt = (Math.round(a * 100) / 100).toLocaleString('sr-Latn-RS', { minimumFractionDigits: 2 });
      box.innerHTML = qrSvg(qrMatrica(r.tekst, 'M'), { naslov: `IPS QR kod za uplatu ${iznosTxt} RSD` });
    }

    let t = 0;
    const odlozeno = () => {
      clearTimeout(t);
      t = window.setTimeout(osvjezi, 150);
    };
    iznos.addEventListener('input', odlozeno);
    svrha.addEventListener('input', odlozeno);
    root.querySelectorAll<HTMLButtonElement>('[data-ips-brzo]').forEach((b) =>
      b.addEventListener('click', () => {
        iznos.value = b.dataset.ipsBrzo ?? '';
        osvjezi();
      }),
    );
    if (iznos.value) osvjezi();
  });
</script>
