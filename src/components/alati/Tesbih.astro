---
// Digitalni tesbih: veliki taster, preseti, cilj po želji, vibracija, pamćenje stanja (localStorage).
import { PRESETI, ZIKROVI } from '../../lib/alati/tesbih';

const p0 = PRESETI[0];
const z0 = ZIKROVI[p0.koraci[0].zikr!];
const R = 108;
const OBIM = +(2 * Math.PI * R).toFixed(2);
---
<div class="tb" data-tesbih data-preseti={JSON.stringify(PRESETI)} data-zikrovi={JSON.stringify(ZIKROVI)}>
  <fieldset class="tb__presets">
    <legend class="tb__legend">Odaberite zikr</legend>
    <div class="chips" data-tb-chips>
      {PRESETI.map((p, i) => (
        <button type="button" class="chip" data-tb-preset={p.kljuc} aria-pressed={i === 0 ? 'true' : 'false'}>{p.naziv}</button>
      ))}
    </div>
    <p class="tb__opis muted" data-tb-opis>{p0.opis}</p>
  </fieldset>

  <div class="tb__main">
    <div class="tb__zikr" data-tb-zikr aria-live="polite">
      <p class="tb__step" data-tb-step>Korak 1 od {p0.koraci.length}</p>
      <p class="tb__ar" lang="ar" dir="rtl" data-tb-ar>{z0.arapski}</p>
      <p class="tb__name" data-tb-name>{z0.naziv}</p>
      <p class="tb__mean" data-tb-mean>{z0.znacenje}</p>
    </div>

    <button type="button" class="tb__btn" data-tb-btn aria-describedby="tb-help">
      <svg class="tb__ring" viewBox="0 0 240 240" aria-hidden="true">
        <circle cx="120" cy="120" r={R} class="tb__ring-bg" />
        <circle cx="120" cy="120" r={R} class="tb__ring-fg" data-tb-ring stroke-dasharray={OBIM} stroke-dashoffset={OBIM} data-obim={OBIM} />
      </svg>
      <span class="tb__count" data-tb-count>0</span>
      <span class="tb__target">od <span data-tb-target>{p0.koraci[0].cilj}</span></span>
      <span class="visually-hidden" data-tb-sr>Dodaj jedan</span>
    </button>
    <p id="tb-help" class="tb__help muted">Dodirnite krug ili pritisnite razmaknicu / Enter.</p>
    <p class="tb__done" role="status" aria-live="assertive" data-tb-status></p>

    <div class="tb__controls">
      <button type="button" class="btn btn--ghost btn--sm" data-tb-undo aria-label="−1 (oduzmi jedan)">−1</button>
      <button type="button" class="btn btn--ghost btn--sm" data-tb-reset>Poništi brojač</button>
    </div>
  </div>

  <div class="tb__settings card">
    <div class="tb__row">
      <label for="tb-cilj" class="tb__label">Cilj (broj ponavljanja)</label>
      <div class="tb__target-set">
        <input id="tb-cilj" class="input" type="number" inputmode="numeric" min="1" max="100000" step="1" value={p0.koraci[0].cilj} data-tb-cilj />
        <div class="tb__quick" role="group" aria-label="Brzi izbor cilja">
          {[33, 34, 99, 100].map((n) => <button type="button" class="chip" data-tb-quick={n}>{n}</button>)}
        </div>
      </div>
    </div>
    <label class="tb__check">
      <input type="checkbox" data-tb-vib checked />
      <span>Vibracija na svakih 33 i na cilju <span class="muted" data-tb-vib-note></span></span>
    </label>
    <dl class="tb__stats">
      <div><dt>Ukupno izgovoreno</dt><dd data-tb-total>0</dd></div>
      <div><dt>Završenih krugova</dt><dd data-tb-rounds>0</dd></div>
    </dl>
    <button type="button" class="btn btn--ghost btn--sm" data-tb-clear>Obriši statistiku</button>
    <p class="tb__privacy muted">Stanje se čuva samo u vašem pregledaču (na ovom uređaju).</p>
  </div>
</div>

<style>
  .tb { display: grid; gap: var(--space-6); }
  .tb__presets { border: 0; padding: 0; margin: 0; min-width: 0; }
  .tb__legend { font-weight: 700; margin-bottom: var(--space-3); padding: 0; }
  .tb__opis { margin: var(--space-3) 0 0; font-size: 0.92rem; min-height: 3em; }
  .tb__main { display: grid; justify-items: center; text-align: center; gap: var(--space-3); }
  .tb__zikr { min-height: 11.5rem; display: grid; align-content: center; gap: var(--space-1); max-width: 34rem; }
  .tb__zikr p { margin: 0; }
  .tb__step { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent); min-height: 1.4em; }
  .tb__ar { font-size: clamp(1.9rem, 4vw + 1rem, 2.6rem); line-height: 1.9; color: var(--color-text); min-height: 1.9em; }
  .tb__name { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 600; }
  .tb__mean { color: var(--color-text-muted); font-size: 0.95rem; min-height: 1.6em; }
  .tb__btn {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    width: min(78vw, 300px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: radial-gradient(circle at 50% 35%, var(--color-surface), var(--color-surface-2));
    box-shadow: var(--shadow-md), inset 0 0 0 1px var(--color-border);
    color: var(--color-text);
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 80ms ease, box-shadow var(--transition);
  }
  .tb__btn:active, .tb__btn.is-tap { transform: scale(0.97); }
  .tb__btn:focus-visible { outline: 4px solid var(--color-focus); outline-offset: 6px; border-radius: 50%; }
  .tb__ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .tb__ring-bg { fill: none; stroke: var(--color-border); stroke-width: 10; }
  .tb__ring-fg { fill: none; stroke: var(--color-primary); stroke-width: 10; stroke-linecap: round; transition: stroke-dashoffset 120ms ease; }
  .tb.is-done .tb__ring-fg { stroke: var(--color-accent-bright); }
  .tb__count { position: relative; font-family: var(--font-serif); font-size: clamp(3.5rem, 14vw, 5rem); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  .tb__target { position: relative; color: var(--color-text-muted); font-weight: 600; margin-top: var(--space-2); }
  .tb__help { font-size: 0.88rem; margin: 0; }
  .tb__done { min-height: 1.6em; margin: 0; font-weight: 700; color: var(--color-success); }
  .tb__controls { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; }
  .tb__settings { display: grid; gap: var(--space-4); max-width: 40rem; width: 100%; margin-inline: auto; }
  .tb__label { font-weight: 700; display: block; margin-bottom: var(--space-2); }
  .tb__target-set { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .tb__target-set .input { width: 8rem; }
  .tb__quick { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .tb__check { display: flex; gap: var(--space-2); align-items: flex-start; cursor: pointer; min-height: 40px; padding-block: 0.5rem; }
  .tb__check input { width: 1.2rem; height: 1.2rem; margin-top: 0.25rem; accent-color: var(--color-primary); }
  .tb__stats { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin: 0; }
  .tb__stats div { background: var(--color-surface-2); border-radius: var(--radius-md); padding: var(--space-3); }
  .tb__stats dt { font-size: 0.82rem; color: var(--color-text-muted); }
  .tb__stats dd { margin: 0; font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .tb__settings .btn { justify-self: start; }
  .tb__privacy { font-size: 0.85rem; margin: 0; }
  @media (min-width: 960px) {
    .tb { grid-template-columns: 1.3fr 1fr; align-items: start; }
    .tb__presets { grid-column: 1 / -1; }
  }
</style>

<script>
  import type { Preset, Zikr } from '../../lib/alati/tesbih.ts';

  const KLJUC = 'dzj-tesbih-v1';
  interface Stanje {
    preset: string;
    korak: number;
    broj: number;
    cilj: number | null;
    ukupno: number;
    krugova: number;
    vibracija: boolean;
  }

  const root = document.querySelector<HTMLElement>('[data-tesbih]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const preseti: Preset[] = JSON.parse(root.dataset.preseti ?? '[]');
    const zikrovi: Record<string, Zikr> = JSON.parse(root.dataset.zikrovi ?? '{}');

    const elCount = $('[data-tb-count]');
    const elTarget = $('[data-tb-target]');
    const elRing = $<SVGCircleElement>('[data-tb-ring]');
    const obim = Number(elRing.dataset.obim);
    const elStep = $('[data-tb-step]');
    const elAr = $('[data-tb-ar]');
    const elName = $('[data-tb-name]');
    const elMean = $('[data-tb-mean]');
    const elOpis = $('[data-tb-opis]');
    const elStatus = $('[data-tb-status]');
    const elSr = $('[data-tb-sr]');
    const btn = $<HTMLButtonElement>('[data-tb-btn]');
    const inCilj = $<HTMLInputElement>('[data-tb-cilj]');
    const chkVib = $<HTMLInputElement>('[data-tb-vib]');
    const elTotal = $('[data-tb-total]');
    const elRounds = $('[data-tb-rounds]');
    const btnReset = $<HTMLButtonElement>('[data-tb-reset]');

    const mozeVibracija = 'vibrate' in navigator;
    if (!mozeVibracija) $('[data-tb-vib-note]').textContent = '(ovaj uređaj/pregledač ne podržava vibraciju)';

    let s: Stanje = { preset: preseti[0].kljuc, korak: 0, broj: 0, cilj: null, ukupno: 0, krugova: 0, vibracija: true };
    try {
      const raw = localStorage.getItem(KLJUC);
      if (raw) s = { ...s, ...JSON.parse(raw) };
    } catch {
      /* privatni režim ili blokirano skladište — radi bez pamćenja */
    }
    const sacuvaj = () => {
      try {
        localStorage.setItem(KLJUC, JSON.stringify(s));
      } catch {
        /* ignoriši */
      }
    };

    const preset = () => preseti.find((p) => p.kljuc === s.preset) ?? preseti[0];
    const cilj = () => {
      const p = preset();
      if (p.koraci.length > 1) return p.koraci[Math.min(s.korak, p.koraci.length - 1)].cilj;
      return s.cilj ?? p.koraci[0].cilj;
    };
    const vib = (obrazac: number | number[]) => {
      const ua = (navigator as Navigator & { userActivation?: { hasBeenActive: boolean } }).userActivation;
      if (s.vibracija && mozeVibracija && (!ua || ua.hasBeenActive)) navigator.vibrate(obrazac);
    };

    function render() {
      const p = preset();
      const k = p.koraci[Math.min(s.korak, p.koraci.length - 1)];
      const z = k.zikr ? zikrovi[k.zikr] : null;
      root!.querySelectorAll<HTMLButtonElement>('[data-tb-preset]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.tbPreset === p.kljuc)),
      );
      elOpis.textContent = p.opis;
      elStep.textContent = p.koraci.length > 1 ? `Korak ${s.korak + 1} od ${p.koraci.length}` : ' ';
      elAr.textContent = z ? z.arapski : ' ';
      elName.textContent = z ? z.naziv : 'Slobodno brojanje';
      elMean.textContent = z ? z.znacenje : 'Izgovarajte zikr po svom izboru.';
      const c = cilj();
      elCount.textContent = String(s.broj);
      elTarget.textContent = String(c);
      elRing.setAttribute('stroke-dashoffset', String(obim * (1 - Math.min(1, s.broj / c))));
      elSr.textContent = `Dodaj jedan. Trenutno ${s.broj} od ${c}.`;
      inCilj.value = String(c);
      inCilj.disabled = p.koraci.length > 1;
      root!.querySelectorAll<HTMLButtonElement>('[data-tb-quick]').forEach((b) => (b.disabled = p.koraci.length > 1));
      chkVib.checked = s.vibracija;
      elTotal.textContent = s.ukupno.toLocaleString('sr-Latn-RS');
      elRounds.textContent = s.krugova.toLocaleString('sr-Latn-RS');
      root!.classList.toggle('is-done', s.broj >= c);
    }

    function dodaj() {
      const p = preset();
      const c = cilj();
      if (s.broj >= c) {
        // novi krug: nakon zadnjeg koraka sekvence kreće se ispočetka
        s.broj = 0;
        if (p.koraci.length > 1) s.korak = 0;
      }
      s.broj++;
      s.ukupno++;
      elStatus.textContent = '';
      if (s.broj >= c) {
        if (p.koraci.length > 1 && s.korak < p.koraci.length - 1) {
          const sljedeci = p.koraci[s.korak + 1].zikr;
          s.korak++;
          s.broj = 0;
          vib([90, 60, 90]);
          elStatus.textContent = `${c} ✓ — sada: ${sljedeci ? zikrovi[sljedeci].naziv : 'sljedeći zikr'}`;
        } else {
          s.krugova++;
          vib([120, 70, 120, 70, 120]);
          elStatus.textContent = p.koraci.length > 1 ? 'Tesbihat je završen. Allah primio!' : `Cilj od ${c} je dostignut. Allah primio!`;
        }
      } else if (s.broj % 33 === 0) {
        vib(70);
      }
      btn.classList.add('is-tap');
      setTimeout(() => btn.classList.remove('is-tap'), 90);
      sacuvaj();
      render();
    }

    btn.addEventListener('click', dodaj);
    document.addEventListener('keydown', (e) => {
      // samo kada fokus nije na kontroli (dugme samo obrađuje Space/Enter kao klik)
      const t = e.target as HTMLElement;
      if (t !== document.body && t !== document.documentElement) return;
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        if (!e.repeat) dodaj();
      } else if (e.key === 'Backspace') {
        e.preventDefault();
        undo();
      }
    });

    function undo() {
      if (s.broj > 0) {
        s.broj--;
        s.ukupno = Math.max(0, s.ukupno - 1);
        elStatus.textContent = '';
        sacuvaj();
        render();
      }
    }
    $('[data-tb-undo]').addEventListener('click', undo);

    let resetTimer = 0;
    btnReset.addEventListener('click', () => {
      if (!btnReset.dataset.potvrdi) {
        btnReset.dataset.potvrdi = '1';
        btnReset.textContent = 'Potvrdite poništavanje';
        resetTimer = window.setTimeout(() => {
          delete btnReset.dataset.potvrdi;
          btnReset.textContent = 'Poništi brojač';
        }, 3000);
        return;
      }
      clearTimeout(resetTimer);
      delete btnReset.dataset.potvrdi;
      btnReset.textContent = 'Poništi brojač';
      s.broj = 0;
      s.korak = 0;
      elStatus.textContent = 'Brojač je poništen.';
      sacuvaj();
      render();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-tb-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        if (b.dataset.tbPreset === s.preset) return;
        s.preset = b.dataset.tbPreset!;
        s.korak = 0;
        s.broj = 0;
        s.cilj = null;
        elStatus.textContent = '';
        sacuvaj();
        render();
      }),
    );

    const postaviCilj = (n: number) => {
      if (!Number.isFinite(n) || n < 1) return;
      s.cilj = Math.min(100000, Math.round(n));
      sacuvaj();
      render();
    };
    inCilj.addEventListener('change', () => postaviCilj(Number(inCilj.value)));
    root.querySelectorAll<HTMLButtonElement>('[data-tb-quick]').forEach((b) =>
      b.addEventListener('click', () => postaviCilj(Number(b.dataset.tbQuick))),
    );
    chkVib.addEventListener('change', () => {
      s.vibracija = chkVib.checked;
      sacuvaj();
    });
    $('[data-tb-clear]').addEventListener('click', () => {
      s.ukupno = 0;
      s.krugova = 0;
      sacuvaj();
      render();
    });

    render();
  }
</script>
