---
// Kontakt forma bez backenda.
// - Ako je postavljen PUBLIC_FORM_ENDPOINT (npr. Formspree), šalje se fetch POST-om (JSON odgovor).
// - Inače se pravi mailto: link na data.dzamija.kontakt.email.
// - Ako ni e-mail nije poznat: Placeholder + onemogućeno slanje uz objašnjenje.
import Placeholder from '../ui/Placeholder.astro';
import { dzamija } from '../../lib/data';

interface Props { id?: string }
const { id = 'kontakt-forma' } = Astro.props;
const endpoint = (import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined)?.trim() || '';
const email = dzamija.kontakt.email;
const nacin = endpoint ? 'endpoint' : email ? 'mailto' : 'nema';
const teme = ['Opšte', 'Mekteb', 'Halke', 'Donacije', 'Ostalo'];
const ig = dzamija.drustveneMreze.instagram;
const fb = dzamija.drustveneMreze.facebook;
---
<form
  class="cf"
  id={id}
  novalidate
  data-cf
  data-nacin={nacin}
  data-endpoint={endpoint || undefined}
  data-email={email ?? undefined}
  action={endpoint || undefined}
  method={endpoint ? 'post' : undefined}
  aria-describedby={nacin === 'nema' ? `${id}-nema` : undefined}
>
  <div class="cf__summary" role="alert" tabindex="-1" data-cf-summary hidden></div>

  <div class="cf__row">
    <div class="field cf__field">
      <label for={`${id}-ime`}>Ime i prezime <span class="cf__req" aria-hidden="true">*</span></label>
      <input class="input" id={`${id}-ime`} name="ime" type="text" autocomplete="name" required minlength="2" maxlength="100" aria-describedby={`${id}-ime-err`} />
      <p class="cf__err" id={`${id}-ime-err`} data-cf-err="ime"></p>
    </div>
    <div class="field cf__field">
      <label for={`${id}-email`}>E-mail <span class="cf__req" aria-hidden="true">*</span></label>
      <input class="input" id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" aria-describedby={`${id}-email-err`} />
      <p class="cf__err" id={`${id}-email-err`} data-cf-err="email"></p>
    </div>
  </div>

  <div class="field cf__field">
    <label for={`${id}-tema`}>Tema</label>
    <select class="select" id={`${id}-tema`} name="tema">
      {teme.map((t) => <option value={t}>{t}</option>)}
    </select>
  </div>

  <div class="field cf__field">
    <label for={`${id}-poruka`}>Poruka <span class="cf__req" aria-hidden="true">*</span></label>
    <textarea class="textarea" id={`${id}-poruka`} name="poruka" rows="6" required minlength="10" maxlength="5000" aria-describedby={`${id}-poruka-err ${id}-poruka-hint`}></textarea>
    <p class="cf__hint" id={`${id}-poruka-hint`}>Najmanje 10 znakova. <span data-cf-brojac>0</span>/5000</p>
    <p class="cf__err" id={`${id}-poruka-err`} data-cf-err="poruka"></p>
  </div>

  <!-- zamka za botove: ljudi ovo polje ne vide -->
  <div class="cf__hp" aria-hidden="true">
    <label for={`${id}-web`}>Ne popunjavajte ovo polje</label>
    <input id={`${id}-web`} name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="cf__note muted">Polja označena zvjezdicom (*) su obavezna. Podaci se koriste samo za odgovor na vašu poruku.</p>

  {nacin === 'nema' && (
    <div class="cf__nema" id={`${id}-nema`}>
      <Placeholder label="e-mail adresa džamije za kontakt formu" hint="slanje je privremeno onemogućeno" />
      <p class="muted">
        Dok džemat ne objavi zvanični e-mail, pišite preko
        {ig && <> <a href={ig} target="_blank" rel="noopener">Instagrama</a></>}
        {ig && fb && ' ili'}
        {fb && <> <a href={fb} target="_blank" rel="noopener">Facebook stranice</a></>}
        {!ig && !fb && ' društvenih mreža džamije'}.
      </p>
    </div>
  )}

  <div class="cf__actions">
    <button class="btn btn--primary" type="submit" data-cf-submit disabled={nacin === 'nema'} aria-disabled={nacin === 'nema' ? 'true' : undefined}>
      {nacin === 'mailto' ? 'Otvori e-mail poruku' : 'Pošalji poruku'}
    </button>
    {nacin === 'mailto' && <span class="cf__how muted">Otvoriće se vaš program za e-poštu sa popunjenom porukom.</span>}
  </div>

  <div class="cf__status" role="status" aria-live="polite" data-cf-status></div>
</form>

<style>
  .cf { display: grid; gap: var(--space-4); }
  .cf [hidden] { display: none !important; }
  .cf__row { display: grid; gap: var(--space-4); }
  @media (min-width: 640px) { .cf__row { grid-template-columns: 1fr 1fr; } }
  .cf__field { gap: var(--space-1); }
  .cf__req { color: var(--color-danger); }
  .cf__err { margin: 0; min-height: 0; color: var(--color-danger); font-size: 0.88rem; font-weight: 600; }
  .cf__err:empty { display: none; }
  .cf__hint { margin: 0; font-size: 0.82rem; color: var(--color-text-muted); }
  .cf :global([aria-invalid='true']) { border-color: var(--color-danger); box-shadow: 0 0 0 1px var(--color-danger); }
  .cf__hp { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .cf__note { margin: 0; font-size: 0.85rem; }
  .cf__nema { display: grid; gap: var(--space-2); }
  .cf__nema p { margin: 0; font-size: 0.9rem; }
  .cf__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .cf__how { font-size: 0.85rem; }
  .cf__summary {
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-danger);
    border-radius: var(--radius-md);
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 8%, var(--color-surface));
    font-weight: 600;
  }
  .cf__summary :global(ul) { margin: var(--space-2) 0 0; padding-left: 1.2em; font-weight: 500; }
  .cf__summary :global(a) { color: inherit; }
  .cf__status:empty { display: none; }
  .cf__status {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 600;
  }
  .cf__status[data-tip='ok'] { background: color-mix(in srgb, var(--color-success) 12%, var(--color-surface)); color: var(--color-success); border: 1.5px solid var(--color-success); }
  .cf__status[data-tip='greska'] { background: color-mix(in srgb, var(--color-danger) 8%, var(--color-surface)); color: var(--color-danger); border: 1.5px solid var(--color-danger); }
  .cf__status[data-tip='info'] { background: var(--color-surface-2); color: var(--color-text); border: 1.5px solid var(--color-border-strong); }
</style>

<script>
  type Polje = 'ime' | 'email' | 'poruka';
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function init(form: HTMLFormElement) {
    const nacin = form.dataset.nacin;
    const summary = form.querySelector<HTMLElement>('[data-cf-summary]')!;
    const status = form.querySelector<HTMLElement>('[data-cf-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-cf-submit]')!;
    const brojac = form.querySelector<HTMLElement>('[data-cf-brojac]');
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    const NAZIV: Record<Polje, string> = { ime: 'Ime i prezime', email: 'E-mail', poruka: 'Poruka' };
    const dodirnuto = new Set<Polje>();

    function greska(p: Polje): string {
      const v = el(p).value.trim();
      if (p === 'ime') {
        if (!v) return 'Upišite ime i prezime.';
        if (v.length < 2) return 'Ime je prekratko.';
      }
      if (p === 'email') {
        if (!v) return 'Upišite e-mail adresu.';
        if (!EMAIL_RE.test(v)) return 'E-mail adresa nije ispravna (npr. ime@primjer.com).';
      }
      if (p === 'poruka') {
        if (!v) return 'Upišite poruku.';
        if (v.length < 10) return `Poruka je prekratka (još ${10 - v.length} znakova).`;
        if (v.length > 5000) return 'Poruka je preduga (najviše 5000 znakova).';
      }
      return '';
    }

    function prikazi(p: Polje): string {
      const g = greska(p);
      const input = el(p);
      const errEl = form.querySelector<HTMLElement>(`[data-cf-err="${p}"]`)!;
      errEl.textContent = g;
      if (g) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
      return g;
    }

    (['ime', 'email', 'poruka'] as Polje[]).forEach((p) => {
      const input = el(p);
      input.addEventListener('blur', () => {
        if (input.value.trim()) dodirnuto.add(p);
        if (dodirnuto.has(p)) prikazi(p);
      });
      input.addEventListener('input', () => {
        if (dodirnuto.has(p) || input.getAttribute('aria-invalid')) prikazi(p);
      });
    });
    const poruka = el('poruka');
    poruka.addEventListener('input', () => {
      if (brojac) brojac.textContent = String(poruka.value.length);
    });

    function postaviStatus(tip: 'ok' | 'greska' | 'info' | '', tekst: string) {
      status.dataset.tip = tip;
      status.textContent = tekst;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      postaviStatus('', '');
      if (nacin === 'nema') return;
      const greske = (['ime', 'email', 'poruka'] as Polje[])
        .map((p) => ({ p, g: prikazi(p) }))
        .filter((x) => x.g);
      (['ime', 'email', 'poruka'] as Polje[]).forEach((p) => dodirnuto.add(p));
      if (greske.length) {
        summary.hidden = false;
        summary.innerHTML = '';
        const naslov = document.createElement('p');
        naslov.style.margin = '0';
        naslov.textContent = greske.length === 1 ? 'Ispravite jedno polje:' : `Ispravite ${greske.length} polja:`;
        const ul = document.createElement('ul');
        for (const { p, g } of greske) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${el(p).id}`;
          a.textContent = `${NAZIV[p]}: ${g}`;
          a.addEventListener('click', (ev) => {
            ev.preventDefault();
            el(p).focus();
          });
          li.append(a);
          ul.append(li);
        }
        summary.append(naslov, ul);
        el(greske[0].p).focus();
        return;
      }
      summary.hidden = true;

      // zamka za botove: tiho "uspješno"
      if ((el('_gotcha') as HTMLInputElement).value) {
        postaviStatus('ok', 'Hvala! Poruka je poslana.');
        form.reset();
        return;
      }

      const ime = el('ime').value.trim();
      const email = el('email').value.trim();
      const tema = el('tema').value;
      const tekst = poruka.value.trim();

      if (nacin === 'endpoint') {
        submit.disabled = true;
        const staro = submit.textContent;
        submit.textContent = 'Šaljem…';
        try {
          const fd = new FormData();
          fd.set('ime', ime);
          fd.set('email', email);
          fd.set('tema', tema);
          fd.set('poruka', tekst);
          fd.set('_subject', `[Džamija na Jaliji] ${tema} — ${ime}`);
          const r = await fetch(form.dataset.endpoint!, {
            method: 'POST',
            body: fd,
            headers: { Accept: 'application/json' },
          });
          if (!r.ok) throw new Error(String(r.status));
          form.reset();
          if (brojac) brojac.textContent = '0';
          dodirnuto.clear();
          postaviStatus('ok', 'Hvala! Vaša poruka je poslana. Odgovorićemo u najkraćem roku, in šā Allāh.');
        } catch {
          postaviStatus('greska', 'Poruka nije poslana (problem sa vezom ili servisom). Pokušajte ponovo malo kasnije ili nam se javite preko društvenih mreža.');
        } finally {
          submit.disabled = false;
          submit.textContent = staro;
        }
        return;
      }

      // mailto
      const adresa = form.dataset.email!;
      const subject = `[${tema}] Poruka sa sajta — ${ime}`;
      const body = `${tekst}\n\n—\n${ime}\n${email}`;
      const href = `mailto:${adresa}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = href;
      postaviStatus(
        'info',
        `Otvara se vaš program za e-poštu sa pripremljenom porukom za ${adresa}. Ako se ništa ne desi, pošaljite poruku ručno na tu adresu.`,
      );
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-cf]').forEach(init);
</script>
