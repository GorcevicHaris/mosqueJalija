---
// Stranica-preusmjerenje za statički sajt (GitHub Pages i Vercel): canonical na novu adresu,
// meta refresh, noindex i vidljiv link (ako pregledač ne preusmjeri sam).
// Props: `na` = putanja BEZ base-a ('/imam'), `naslov` = ime odredišta za link.
import { url } from '../../lib/url';

interface Props { na: string; naslov: string }
const { na, naslov } = Astro.props;
const href = url(na);
const site = Astro.site ?? new URL('https://gorcevicharis.github.io');
const canonical = new URL(href, site).href;
---
<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{naslov} | Džamija na Jaliji</title>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
    <script is:inline define:vars={{ href }}>location.replace(href + location.search + location.hash);</script>
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f6efdd; color: #14231d; }
      a { color: #0c3b2e; font-weight: 700; }
      @media (prefers-color-scheme: dark) { body { background: #0b1a15; color: #f6efdd; } a { color: #e2bf6e; } }
    </style>
  </head>
  <body>
    <p>Stranica je premještena: <a href={href}>{naslov}</a></p>
  </body>
</html>
