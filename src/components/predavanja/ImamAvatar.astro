---
// Fotografija imama ili ornamentalni monogram (osmokraka zvijezda) kada slike nema.
import { url } from '../../lib/url';
import { monogram } from '../../lib/predavanja';
interface Props { punoIme: string; slika: string | null; size?: number }
const { punoIme, slika, size = 96 } = Astro.props;
const src = slika ? (/^https?:\/\//.test(slika) ? slika : url(slika)) : null;
---
<span class="avatar" style={`--avatar-size:${size}px`}>
  {src ? (
    <img src={src} alt={`Fotografija: ${punoIme}`} width={size} height={size} loading="lazy" decoding="async" />
  ) : (
    <span class="avatar__mono" role="img" aria-label={`Monogram: ${punoIme} (fotografija nije dostupna)`}>
      <svg viewBox="0 0 100 100" aria-hidden="true" class="avatar__star">
        <g fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="21" y="21" width="58" height="58" rx="3" />
          <rect x="21" y="21" width="58" height="58" rx="3" transform="rotate(45 50 50)" />
          <circle cx="50" cy="50" r="44" stroke-width="1.2" opacity="0.55" />
        </g>
      </svg>
      <span class="avatar__txt" aria-hidden="true">{monogram(punoIme)}</span>
    </span>
  )}
</span>

<style>
  .avatar {
    display: inline-grid;
    place-items: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: 0 0 0 3px var(--color-surface), 0 0 0 5px var(--color-accent-bright);
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .avatar__mono { position: relative; display: grid; place-items: center; width: 100%; height: 100%; }
  .avatar__star { position: absolute; inset: 8%; width: 84%; height: 84%; color: var(--color-accent-bright); opacity: 0.9; }
  .avatar__txt {
    position: relative;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: calc(var(--avatar-size) * 0.3);
    letter-spacing: 0.02em;
  }
</style>
