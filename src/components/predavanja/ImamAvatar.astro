---
// Fotografija imama ili ornamentalni monogram (osmokraka zvijezda) kada slike nema.
// Lokalne fotografije (/images/imami/<slug>.webp, 600×600) imaju i malu varijantu <slug>-200.webp —
// srcset pušta pregledač da izabere manju za male avatare. Slike iz admina (Supabase URL) idu kako jesu.
import { url } from '../../lib/url';
import { monogram } from '../../lib/predavanja';
interface Props {
  punoIme: string;
  slika: string | null;
  size?: number;
  /** true = slika je odmah vidljiva (npr. zaglavlje profila) — bez lazy učitavanja */
  eager?: boolean;
  /** true = ime je već napisano pored (prazan alt, da čitač ne ponavlja) */
  dekorativno?: boolean;
}
const { punoIme, slika, size = 96, eager = false, dekorativno = false } = Astro.props;
const vanjska = !!slika && /^https?:\/\//.test(slika);
const src = slika ? (vanjska ? slika : url(slika)) : null;
const mala = src && !vanjska && /\.webp$/i.test(src) && !/-200\.webp$/i.test(src) ? src.replace(/\.webp$/i, '-200.webp') : null;
const srcset = mala ? `${mala} 200w, ${src} 600w` : undefined;
---
<span class="avatar" style={`--avatar-size:${size}px`}>
  {src ? (
    <img
      src={mala && size <= 100 ? mala : src}
      srcset={srcset}
      sizes={srcset ? `${size}px` : undefined}
      alt={dekorativno ? '' : `Fotografija: ${punoIme}`}
      width={size}
      height={size}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <span class="avatar__mono" role={dekorativno ? undefined : 'img'} aria-label={dekorativno ? undefined : `Monogram: ${punoIme} (fotografija nije dostupna)`} aria-hidden={dekorativno ? 'true' : undefined}>
      <svg viewBox="0 0 100 100" aria-hidden="true" class="avatar__star">
        <g fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="21" y="21" width="58" height="58" rx="3" />
          <rect x="21" y="21" width="58" height="58" rx="3" transform="rotate(45 50 50)" />
          <circle cx="50" cy="50" r="44" stroke-width="1.2" opacity="0.55" />
        </g>
      </svg>
      <span class="avatar__txt" aria-hidden="true">{monogram(punoIme)}</span>
    </span>
  )}
</span>

<style>
  .avatar {
    display: inline-grid;
    place-items: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: 0 0 0 3px var(--color-surface), 0 0 0 5px var(--color-accent-bright);
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .avatar__mono { position: relative; display: grid; place-items: center; width: 100%; height: 100%; }
  .avatar__star { position: absolute; inset: 8%; width: 84%; height: 84%; color: var(--color-accent-bright); opacity: 0.9; }
  .avatar__txt {
    position: relative;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: calc(var(--avatar-size) * 0.3);
    letter-spacing: 0.02em;
  }
</style>
