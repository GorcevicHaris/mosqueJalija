---
// Dugme "Podijeli": Web Share API, a ako nije dostupan — kopira link i prikaže obavijest (toast).
interface Props {
  naslov: string;
  tekst?: string;
  /** apsolutni URL; podrazumijevano trenutna stranica */
  link?: string;
}
const { naslov, tekst, link } = Astro.props;
---
<button
  type="button"
  class="btn btn--ghost share-btn"
  data-share
  data-title={naslov}
  data-text={tekst ?? ''}
  data-url={link ?? ''}
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path></svg>
  Podijeli
</button>

<script>
  function toast(poruka: string) {
    let el = document.querySelector<HTMLElement>('.share-toast');
    if (!el) {
      el = document.createElement('div');
      el.className = 'share-toast';
      el.setAttribute('role', 'status');
      el.setAttribute('aria-live', 'polite');
      document.body.append(el);
    }
    el.textContent = poruka;
    el.dataset.show = '';
    clearTimeout(Number(el.dataset.t));
    el.dataset.t = String(window.setTimeout(() => el && delete el.dataset.show, 2600));
  }
  async function kopiraj(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.append(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      ta.remove();
      return ok;
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url || location.href.split('#')[0];
      const title = btn.dataset.title || document.title;
      const text = btn.dataset.text || undefined;
      if (navigator.share) {
        try {
          await navigator.share({ title, text, url });
          return;
        } catch (e) {
          if ((e as DOMException)?.name === 'AbortError') return;
        }
      }
      toast((await kopiraj(url)) ? 'Link je kopiran.' : 'Kopiranje nije uspjelo — kopirajte adresu iz pregledača.');
    });
  });
</script>

<style is:global>
  .share-toast {
    position: fixed;
    left: 50%;
    bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    z-index: 1000;
    transform: translate(-50%, 20px);
    max-width: calc(100vw - 2 * var(--space-4));
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius-full);
    background: var(--inverse-bg, #0c3b2e);
    color: var(--inverse-text, #fff);
    font-weight: 600;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .share-toast[data-show] { opacity: 1; transform: translate(-50%, 0); }
</style>
