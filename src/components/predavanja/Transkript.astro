---
// Transkript predavanja (whisper.cpp, po mogućnosti lektorisan) + opcioni engleski mašinski prevod
// (data/transkripti-en/). Obje verzije se renderuju na serveru (obje se indeksiraju), neaktivna je
// sakrivena atributom `hidden`; JS samo prebacuje vidljivost (Bosanski | English), dodaje pretragu,
// kopiranje i preuzimanje — tekst se ne šalje u JS-u. Izbor jezika pamti se u localStorage i u URL-u
// (?jezik=en). Elementi sa [data-tr-l="bs|en"] (i van komponente, npr. engleski podnaslov stranice)
// prikazuju se samo za aktivni jezik — na stranici je jedan transkript.
// Klik na vrijeme šalje window CustomEvent 'jalija:seek' {sekunde}; ako player na stranici to ne
// podržava (nema [data-ytf-seek]), link otvara YouTube na tom mjestu.
import { brojRijeci, getTranskript, getTranskriptEn, vrijemeTekst } from '../../lib/transkripti';
import type { Transkript } from '../../lib/transkripti';

interface Props {
  id: string;
  /** naslov za ime .txt fajla i zaglavlje teksta */
  naslov?: string;
}
const { id, naslov } = Astro.props;
const t = getTranskript(id);
const en = t ? getTranskriptEn(id) : null;
const yt = (s: number) => `https://www.youtube.com/watch?v=${encodeURIComponent(id)}&t=${Math.floor(s)}s`;
const datumGen = t ? new Date(t.generisano) : null;
const datumTekst =
  datumGen && !Number.isNaN(datumGen.getTime())
    ? `${datumGen.getUTCDate()}. ${datumGen.getUTCMonth() + 1}. ${datumGen.getUTCFullYear()}.`
    : '';
const naslovBs = !t
  ? ''
  : !t.automatski
    ? 'Transkript'
    : t.lektorisano
      ? 'Automatski transkript (lektorisan)'
      : 'Automatski transkript';
const naslovEn = !t
  ? ''
  : !t.automatski
    ? 'Transcript'
    : t.lektorisano
      ? 'Automatic transcript (proofread)'
      : 'Automatic transcript';
// Odlomak koji je (pretežno) arapski citat ili oznaka "[…]" → prigušen, desno-nalijevo; miješani
// odlomci (arapski citat pa prevod) ostaju lijevo-nadesno, inače bi cijeli pasus bio poravnat udesno.
const vrstaOdlomka = (tekst: string): { ar: boolean; dir: 'rtl' | 'ltr' | 'auto' } => {
  if (tekst.startsWith('[')) return { ar: true, dir: 'auto' };
  const arapskih = (tekst.match(/[\u0600-\u06FF\u0750-\u077F\uFB50-\uFDFF\uFE70-\uFEFF]/g) ?? []).length;
  if (!arapskih) return { ar: false, dir: 'auto' };
  const latinicnih = (tekst.match(/[A-Za-zÀ-žḀ-ỿ]/g) ?? []).length;
  return arapskih > latinicnih * 2 ? { ar: true, dir: 'rtl' } : { ar: false, dir: 'ltr' };
};
const uid = `tr-${id.replace(/[^a-zA-Z0-9_-]/g, '')}`;
const citanje = (tr: Transkript) => {
  const rijeci = brojRijeci(tr);
  return { rijeci, min: Math.max(1, Math.round(rijeci / 200)) };
};
const cBs = t ? citanje(t) : null;
const cEn = en ? citanje(en) : null;
const verzije = [t && { kod: 'bs' as const, tr: t }, en && { kod: 'en' as const, tr: en }].filter(
  (v): v is { kod: 'bs' | 'en'; tr: Transkript } => !!v,
);
---
{t && cBs && (
  <section
    class="tr card"
    aria-labelledby={`${uid}-h`}
    lang="bs"
    data-tr
    data-id={id}
    data-naslov={naslov ?? ''}
    data-naslov-en={en?.naslov ?? ''}
  >
    <div class="tr__head">
      <div class="tr__head-main">
        <svg class="tr__ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6M8 13h8M8 17h5"></path></svg>
        <h2 id={`${uid}-h`} class="tr__title">
          <span data-tr-l="bs">{naslovBs}</span>
          {en && <span data-tr-l="en" lang="en" hidden>{naslovEn}</span>}
        </h2>
      </div>
      {en && (
        <div class="tr__lang" role="group" aria-label="Jezik transkripta / Transcript language" data-tr-jezici hidden>
          <button type="button" class="tr__lang-btn" lang="bs" aria-pressed="true" data-jezik="bs">Bosanski</button>
          <button type="button" class="tr__lang-btn" lang="en" aria-pressed="false" data-jezik="en">English</button>
        </div>
      )}
      <p class="tr__meta muted">
        <span data-tr-l="bs">{cBs.rijeci.toLocaleString('bs')} riječi · oko {cBs.min} min čitanja</span>
        {cEn && <span data-tr-l="en" lang="en" hidden>{cEn.rijeci.toLocaleString('en')} words · about {cEn.min} min read</span>}
      </p>
    </div>

    {t.automatski ? (
      <p class="tr__notice" role="note" data-tr-l="bs">
        <strong>Mašinski generisan tekst.</strong> Transkript je automatski napravljen iz zvuka snimka
        (prepoznavanje govora){t.lektorisano ? ' i naknadno lektorisan (ispravljene očigledne greške), ali nije provjeren uz slušanje' : ' i nije ručno provjeren'}
        — može sadržavati pogrešno prepoznate riječi, imena i naročito arapske citate (ajete, hadise, dove).
        Mjerodavan je video.
      </p>
    ) : (
      <p class="tr__notice tr__notice--ok" role="note" data-tr-l="bs">
        Transkript je ručno pregledan{t.ispravio ? ` (${t.ispravio})` : ''}. Mjerodavan je video.
      </p>
    )}
    {en && (
      <p class="tr__notice" role="note" data-tr-l="en" lang="en" hidden>
        <strong>{naslovEn} — machine translation, may contain errors.</strong> The English text was
        machine-translated from the Bosnian transcript, which was itself generated automatically from the audio.
        Names and Arabic quotations (Qur'an verses, hadith, supplications) may be inaccurate. The video is authoritative.
      </p>
    )}

    <div class="tr__tools" data-tr-tools hidden>
      <div class="tr__search">
        <label class="visually-hidden" for={`${uid}-q`}>
          <span data-tr-l="bs">Pretraži transkript</span>
          {en && <span data-tr-l="en" lang="en" hidden>Search the transcript</span>}
        </label>
        <svg class="tr__search-ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input
          id={`${uid}-q`}
          class="input tr__input"
          type="search"
          placeholder="Pretraži u transkriptu…"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-controls={`${uid}-list-bs`}
          data-tr-q
        />
      </div>
      <div class="tr__btns">
        <button type="button" class="btn btn--ghost btn--sm" data-tr-copy>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path></svg>
          <span data-tr-l="bs">Kopiraj tekst</span>
          {en && <span data-tr-l="en" lang="en" hidden>Copy text</span>}
        </button>
        <button type="button" class="btn btn--ghost btn--sm" data-tr-txt>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path></svg>
          <span data-tr-l="bs">Preuzmi .txt</span>
          {en && <span data-tr-l="en" lang="en" hidden>Download .txt</span>}
        </button>
      </div>
    </div>
    <p class="tr__status muted" role="status" aria-live="polite" data-tr-status></p>

    {verzije.map(({ kod, tr }) => (
      <ol
        class="tr__list"
        id={`${uid}-list-${kod}`}
        lang={kod}
        data-tr-list={kod}
        hidden={kod !== 'bs'}
      >
        {tr.segmenti.map((s) => (
          <li class="tr__seg" id={kod === 'bs' ? `t-${Math.floor(s.od)}` : undefined} data-od={Math.floor(s.od)}>
            <a
              class="tr__time"
              href={yt(s.od)}
              target="_blank"
              rel="noopener"
              data-sek={Math.floor(s.od)}
              aria-label={kod === 'en' ? `Play from ${vrijemeTekst(s.od)}` : `Pusti od ${vrijemeTekst(s.od)}`}
            >
              {vrijemeTekst(s.od)}
            </a>
            {(() => {
              const v = vrstaOdlomka(s.tekst);
              return <p class:list={['tr__txt', { 'tr__txt--ar': v.ar }]} dir={v.dir}>{s.tekst}</p>;
            })()}
          </li>
        ))}
      </ol>
    ))}

    <p class="tr__foot muted">
      <span data-tr-l="bs">
        Model: {t.model}{datumTekst && ` · generisano ${datumTekst}`}. Uočili ste grešku? Javite nam preko stranice za kontakt.
      </span>
      {en && (
        <span data-tr-l="en" lang="en" hidden>
          Speech recognition: {t.model}{en.model && en.model !== t.model ? ` · translation: ${en.model}` : ''}. Spotted an error? Let us know via the contact page.
        </span>
      )}
    </p>
  </section>
)}

<script>
  import { normalizujSaMapom, tokeni } from '../../lib/extras/normalizuj';
  import { kopirajTekst } from '../../lib/kopiraj';

  type Jezik = 'bs' | 'en';
  const KLJUC = 'jalija:jezik-transkripta';
  const TEKST: Record<
    Jezik,
    { pogodaka: (n: number) => string; nema: string; kopirano: string; greska: string; napomena: string; fajl: string; ph: string }
  > = {
    bs: {
      pogodaka: (n) => {
        const d = n % 10, s = n % 100;
        const o = d === 1 && s !== 11 ? 'odlomak sadrži' : d >= 2 && d <= 4 && (s < 12 || s > 14) ? 'odlomka sadrže' : 'odlomaka sadrži';
        return `${n} ${o} traženi pojam.`;
      },
      nema: 'Nema pogodaka u transkriptu.',
      kopirano: 'Tekst transkripta je kopiran.',
      greska: 'Kopiranje nije uspjelo.',
      napomena: 'Automatski transkript (može sadržavati greške).',
      fajl: 'transkript',
      ph: 'Pretraži u transkriptu…',
    },
    en: {
      pogodaka: (n) => `${n} ${n === 1 ? 'passage contains' : 'passages contain'} the search term.`,
      nema: 'No matches in the transcript.',
      kopirano: 'Transcript text copied.',
      greska: 'Copying failed.',
      napomena: 'Automatic transcript, machine-translated from Bosnian (may contain errors).',
      fajl: 'transcript',
      ph: 'Search the transcript…',
    },
  };

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  /** HTML sa <mark> oko pogodaka; null ako neki token ne postoji (svi tokeni moraju biti nađeni). */
  function oznaci(original: string, toks: string[]): string | null {
    const opsezi: [number, number][] = [];
    const nadjeni = new Set<string>();
    for (const dj of ['dj', 'd'] as const) {
      if (dj === 'd' && !/[đĐ]/.test(original)) continue;
      const { tekst, mapa } = normalizujSaMapom(original, dj);
      for (const t of toks) {
        let i = tekst.indexOf(t);
        if (i !== -1) nadjeni.add(t);
        while (i !== -1) {
          opsezi.push([mapa[i], mapa[i + t.length - 1] + 1]);
          i = tekst.indexOf(t, i + t.length);
        }
      }
    }
    if (nadjeni.size < toks.length) return null;
    opsezi.sort((a, b) => a[0] - b[0]);
    let html = '';
    let pos = 0;
    for (const [a, b] of opsezi) {
      if (b <= pos) continue;
      const od = Math.max(a, pos);
      html += esc(original.slice(pos, od)) + '<mark>' + esc(original.slice(od, b)) + '</mark>';
      pos = b;
    }
    return html + esc(original.slice(pos));
  }

  const smanjiPokret = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  interface Lista {
    ol: HTMLOListElement;
    segs: HTMLLIElement[];
    txts: HTMLElement[];
    izvorni: string[];
    vremena: string[];
  }

  function lista(ol: HTMLOListElement): Lista {
    const segs = [...ol.querySelectorAll<HTMLLIElement>('.tr__seg')];
    const txts = segs.map((li) => li.querySelector<HTMLElement>('.tr__txt')!);
    return {
      ol,
      segs,
      txts,
      izvorni: txts.map((p) => p.textContent || ''),
      vremena: segs.map((li) => li.querySelector('.tr__time')?.textContent?.trim() || ''),
    };
  }

  function citajJezik(): Jezik | null {
    const q = new URLSearchParams(location.search).get('jezik');
    if (q === 'en' || q === 'bs') return q;
    try {
      const v = localStorage.getItem(KLJUC);
      if (v === 'en' || v === 'bs') return v;
    } catch {
      /* localStorage nedostupan (privatni režim i sl.) */
    }
    return null;
  }

  function init(root: HTMLElement) {
    const tools = root.querySelector<HTMLElement>('[data-tr-tools]')!;
    const input = root.querySelector<HTMLInputElement>('[data-tr-q]')!;
    const status = root.querySelector<HTMLElement>('[data-tr-status]')!;
    const liste: Partial<Record<Jezik, Lista>> = {};
    root.querySelectorAll<HTMLOListElement>('ol[data-tr-list]').forEach((ol) => {
      liste[ol.dataset.trList as Jezik] = lista(ol);
    });
    const sviSegs = () => [...(liste.bs?.segs ?? []), ...(liste.en?.segs ?? [])];
    const prekidac = root.querySelector<HTMLElement>('[data-tr-jezici]');
    const dugmad = [...(prekidac?.querySelectorAll<HTMLButtonElement>('button[data-jezik]') ?? [])];
    let jezik: Jezik = 'bs';
    const akt = () => (liste[jezik] ?? liste.bs)!;
    tools.hidden = false;

    // ---- pretraga unutar transkripta (aktivni jezik) ----
    function ocisti(l: Lista) {
      l.segs.forEach((li, i) => {
        li.hidden = false;
        l.txts[i].textContent = l.izvorni[i];
      });
    }
    let tajmer = 0;
    function trazi() {
      const l = akt();
      const toks = tokeni(input.value).filter((t) => t.length >= 2 || /\d/.test(t));
      if (!toks.length) {
        ocisti(l);
        status.textContent = '';
        return;
      }
      let n = 0;
      l.segs.forEach((li, i) => {
        const html = oznaci(l.izvorni[i], toks);
        li.hidden = html === null;
        if (html === null) l.txts[i].textContent = l.izvorni[i];
        else {
          l.txts[i].innerHTML = html;
          n++;
        }
      });
      status.textContent = n ? TEKST[jezik].pogodaka(n) : TEKST[jezik].nema;
    }
    input.addEventListener('input', () => {
      clearTimeout(tajmer);
      tajmer = window.setTimeout(trazi, 120);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && input.value) {
        e.preventDefault();
        input.value = '';
        trazi();
      }
    });

    // ---- prebacivanje jezika ----
    function postaviJezik(j: Jezik, zapamti: boolean) {
      if (!liste[j]) j = 'bs';
      const prije = akt();
      jezik = j;
      const sad = akt();
      if (prije !== sad) {
        ocisti(prije);
        // označeni (aktivni) odlomak prenesi u drugi jezik
        const aktivan = prije.segs.find((li) => li.classList.contains('is-active'))?.dataset.od;
        sad.segs.forEach((li) => li.classList.toggle('is-active', aktivan != null && li.dataset.od === aktivan));
      }
      for (const [k, l] of Object.entries(liste)) l!.ol.hidden = k !== j;
      document.querySelectorAll<HTMLElement>('[data-tr-l]').forEach((el) => {
        el.hidden = el.dataset.trL !== j;
      });
      root.lang = j;
      dugmad.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.jezik === j)));
      input.placeholder = TEKST[j].ph;
      input.setAttribute('aria-controls', sad.ol.id);
      if (input.value) trazi();
      else status.textContent = '';

      if (!liste.en) return;
      if (zapamti) {
        try {
          localStorage.setItem(KLJUC, j);
        } catch {
          /* ignoriši */
        }
      }
      // link koji se dijeli nosi izabrani jezik (?jezik=en); bosanski je podrazumijevani → bez parametra
      const u = new URL(location.href);
      if (j === 'en') u.searchParams.set('jezik', 'en');
      else u.searchParams.delete('jezik');
      if (u.href !== location.href) history.replaceState(history.state, '', u.href);
    }
    if (prekidac && liste.en) {
      prekidac.hidden = false;
      dugmad.forEach((b) => b.addEventListener('click', () => postaviJezik(b.dataset.jezik as Jezik, true)));
      const pocetni = citajJezik();
      if (pocetni === 'en') postaviJezik('en', false);
    }

    // ---- tekst za kopiranje/preuzimanje (iz DOM-a aktivnog jezika, bez dupliranja u HTML-u) ----
    const naslovZa = () => (jezik === 'en' && root.dataset.naslovEn) || root.dataset.naslov || '';
    const tekst = () => {
      const l = akt();
      return [
        naslovZa(),
        location.href.split('#')[0],
        TEKST[jezik].napomena,
        '',
        ...l.izvorni.map((t, i) => `[${l.vremena[i]}] ${t}`),
      ]
        .filter((x, i) => x || i > 1)
        .join('\n');
    };

    const copyBtn = root.querySelector<HTMLButtonElement>('[data-tr-copy]')!;
    copyBtn.addEventListener('click', async () => {
      const ok = await kopirajTekst(tekst());
      status.textContent = ok ? TEKST[jezik].kopirano : TEKST[jezik].greska;
    });

    root.querySelector<HTMLButtonElement>('[data-tr-txt]')!.addEventListener('click', () => {
      const blob = new Blob([tekst() + '\n'], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      const ime = (naslovZa() || root.dataset.id || TEKST[jezik].fajl)
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/đ/gi, 'dj')
        .replace(/[^a-zA-Z0-9]+/g, '-')
        .replace(/^-|-$/g, '')
        .slice(0, 80)
        .toLowerCase();
      a.href = URL.createObjectURL(blob);
      a.download = `${TEKST[jezik].fajl}-${ime || 'predavanje'}${jezik === 'en' ? '-en' : ''}.txt`;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    });

    // ---- vremenske oznake → premotavanje playera (oba jezika) ----
    root.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-sek]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
      const player = document.querySelector<HTMLElement>('[data-ytf][data-ytf-seek]');
      if (!player) return; // player ne podržava premotavanje → otvori YouTube (href)
      e.preventDefault();
      const sekunde = Number(a.dataset.sek) || 0;
      window.dispatchEvent(new CustomEvent('jalija:seek', { detail: { sekunde } }));
      const li = a.closest('li');
      sviSegs().forEach((s) => s.classList.toggle('is-active', s === li));
      const r = player.getBoundingClientRect();
      if (r.top < 0 || r.bottom > innerHeight) {
        player.scrollIntoView({ behavior: smanjiPokret() ? 'auto' : 'smooth', block: 'center' });
      }
    });

    // ---- link na odlomak: /predavanja/<id>#t-123 (radi u oba jezika) ----
    const otvoriHash = () => {
      const m = /^#t-(\d+)$/.exec(location.hash);
      if (!m) return;
      const n = Number(m[1]);
      const segs = akt().segs;
      const li = segs.find((s) => Number(s.dataset.od) === n) ?? segs.filter((s) => Number(s.dataset.od) <= n).pop();
      if (!li) return;
      sviSegs().forEach((s) => s.classList.toggle('is-active', s === li));
      // dugme „Pokreni video“ tada kreće od tog odlomka (ako video još nije pokrenut)
      const player = document.querySelector<HTMLElement>('[data-ytf][data-ytf-seek]');
      if (player && !player.querySelector('iframe')) player.dataset.start = String(li.dataset.od ?? n);
      // nakon što pregledač završi vlastito skrolovanje na hash
      const skroluj = () => li.scrollIntoView({ block: 'start', behavior: 'instant' });
      setTimeout(skroluj, 60);
      if (document.readyState !== 'complete') addEventListener('load', () => setTimeout(skroluj, 0), { once: true });
    };
    otvoriHash();
    addEventListener('hashchange', otvoriHash);
  }

  document.querySelectorAll<HTMLElement>('[data-tr]').forEach(init);
</script>

<style>
  .tr {
    margin-top: var(--space-5);
    padding: 0 0 var(--space-5);
    overflow: clip;
  }
  .tr [hidden] { display: none !important; }
  .tr__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-4) var(--space-5) var(--space-3);
  }
  .tr__head-main { display: flex; align-items: center; gap: var(--space-2); flex: 1 1 auto; min-width: 0; }
  .tr__ico { color: var(--color-primary); flex: none; }
  .tr__title { font-size: 1.2rem; margin: 0; overflow-wrap: anywhere; }
  .tr__meta { order: 3; flex-basis: 100%; margin: 0; font-size: 0.86rem; }

  /* Bosanski | English — segmentirani prekidač */
  .tr__lang {
    display: inline-flex;
    flex: none;
    gap: 2px;
