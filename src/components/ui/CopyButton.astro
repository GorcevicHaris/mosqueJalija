---
// Dugme "Kopiraj" (clipboard). Radi i bez Clipboard API-ja (fallback execCommand).
import Icon from './Icon.astro';
interface Props { text: string; label?: string; small?: boolean; class?: string }
const { text, label = 'Kopiraj', small = true, class: cls } = Astro.props;
---
<button type="button" class:list={['btn btn--ghost copy-btn', { 'btn--sm': small }, cls]} data-copy={text} data-label={label}>
  <Icon name="copy" size={16} />
  <span class="copy-btn__label" aria-live="polite">{label}</span>
</button>
<script>
  import { kopirajTekst } from '../../lib/kopiraj';
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!btn) return;
    const text = btn.dataset.copy ?? '';
    const ok = await kopirajTekst(text);
    const lbl = btn.querySelector('.copy-btn__label');
    if (!lbl) return;
    lbl.textContent = ok ? 'Kopirano ✓' : 'Kopiranje nije uspjelo';
    window.setTimeout(() => { lbl.textContent = btn.dataset.label ?? 'Kopiraj'; }, 2200);
  });
</script>
