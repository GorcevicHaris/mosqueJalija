---
// UGOVOR: props { title, subtitle?, eyebrow?, arabic? } — zaglavlje podstranice.
// `arabic` = kratak arapski tekst (kaligrafski prikaz); koristiti samo provjeren tekst.
// Slot (opcionalno) = dodatni sadržaj ispod podnaslova (npr. dugmad).
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  arabic?: string;
}
const { title, subtitle, eyebrow, arabic } = Astro.props;
---
<header class="page-hero theme-inverse pattern-bg">
  <div class="page-hero__glow" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    {arabic && <p class="page-hero__arabic calligraphy" lang="ar" dir="rtl">{arabic}</p>}
    {eyebrow && <p class="eyebrow page-hero__eyebrow">{eyebrow}</p>}
    <h1 class="page-hero__title">{title}</h1>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
    {Astro.slots.has('default') && <div class="page-hero__extra"><slot /></div>}
  </div>
  <div class="page-hero__arcade" aria-hidden="true"></div>
</header>
<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.75rem, 7vw, 5rem) clamp(3.25rem, 8vw, 5.75rem);
    text-align: center;
    border-bottom: 0;
  }
  .page-hero__glow {
    position: absolute;
    inset: -40% -10% auto;
    height: 140%;
    background: radial-gradient(ellipse at 50% 0%, rgb(226 191 110 / 0.18), transparent 60%);
    pointer-events: none;
  }
  .page-hero__inner { position: relative; max-width: 860px; }
  .page-hero__arabic {
    font-size: clamp(1.6rem, 3vw + 0.8rem, 2.4rem);
    color: var(--inverse-accent);
    margin: 0 0 var(--space-2);
  }
  .page-hero__eyebrow { justify-content: center; }
  .page-hero__title {
    color: var(--inverse-text);
    margin-bottom: var(--space-3);
    font-size: clamp(2rem, 4vw + 0.8rem, 3.3rem);
  }
  .page-hero__subtitle {
    color: var(--inverse-muted);
    font-size: clamp(1.05rem, 0.6vw + 0.95rem, 1.22rem);
    max-width: 62ch;
    margin: 0 auto;
  }
  .page-hero__extra { margin-top: var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; }
  .page-hero__arcade {
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 16px;
    background:
      radial-gradient(circle at 50% 100%, var(--page-bg, #f7f1e3) 11px, transparent 11.5px) 0 0 / 30px 16px repeat-x;
  }
</style>
