---
// UGOVOR: props { label: string }. Vidljiva oznaka da podatak nedostaje — sajt NE izmišlja podatke.
// Opcionalno: `inline` za prikaz unutar rečenice/reda, `hint` za kratko pojašnjenje.
interface Props { label: string; inline?: boolean; hint?: string }
const { label, inline = false, hint } = Astro.props;
const Tag = inline ? 'span' : 'div';
---
<Tag class:list={['placeholder', { 'placeholder--inline': inline }]} data-placeholder>
  <svg class="placeholder__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
  <span class="placeholder__text"><strong>Podatak nedostaje:</strong> {label}{hint && <span class="placeholder__hint"> — {hint}</span>}</span>
</Tag>
<style>
  .placeholder {
    display: flex;
    align-items: flex-start;
    gap: 0.55em;
    padding: 0.75rem 1rem;
    border: 2px dashed var(--color-missing-border);
    border-radius: var(--radius-md);
    background: var(--color-missing-bg);
    color: var(--color-missing-text);
    font-family: var(--font-sans);
    font-size: 0.93rem;
    line-height: 1.45;
    text-align: left;
    direction: ltr;
  }
  .placeholder--inline {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.55rem;
    border-width: 1.5px;
    border-radius: var(--radius-sm);
    font-size: 0.86em;
    vertical-align: middle;
  }
  .placeholder__icon { flex: none; margin-top: 0.1em; }
  .placeholder--inline .placeholder__icon { width: 14px; height: 14px; margin: 0; }
  .placeholder strong { font-weight: 800; }
  .placeholder__hint { opacity: 0.9; }
</style>
