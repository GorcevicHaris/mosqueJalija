---
// UGOVOR (ne mijenjati props bez dogovora): title, description?, image?, noindex?
// Dizajner zamjenjuje implementaciju (head/SEO/OG, header, footer, tema).
interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const { title, description = 'Džamija na Jaliji' } = Astro.props;
---
<html lang="sr-Latn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main id="sadrzaj"><slot /></main>
  </body>
</html>
