---
// UGOVOR (ne mijenjati props bez dogovora): title, description?, image?, noindex?
// Vlasnik: dizajner. Sadrži <head> (SEO, OG/Twitter, JSON-LD, tema bez bljeska), header, footer.
import '@fontsource-variable/fraunces/index.css';
import '@fontsource-variable/manrope/index.css';
import '@fontsource/amiri/arabic-400.css';
import '@fontsource/amiri/arabic-700.css';
import '@fontsource/amiri/latin-400.css';
import '@fontsource/amiri/latin-ext-400.css';
import '@fontsource/aref-ruqaa/arabic-700.css';
import '../styles/global.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { url } from '../lib/url';
import { dzamija } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const SITE_NAME = 'Džamija na Jaliji';
const DEFAULT_DESC =
  dzamija.kratakOpis ??
  'Džamija na Jaliji — predavanja i hutbe sa YouTube kanala, vaktija (namaska vremena), obavještenja, mekteb, dove i korisne informacije za džemat.';

const { title, description = DEFAULT_DESC, image, noindex = false } = Astro.props;

const fullTitle = !title || title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
const site = Astro.site ?? new URL('https://gorcevicharis.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imgPath = image ?? '/og-image.png';
// `image` smije biti apsolutni URL, putanja sa base-om ili putanja bez base-a ('/images/x.jpg').
const ogImage = /^https?:\/\//.test(imgPath)
  ? imgPath
  : new URL(base && imgPath.startsWith(base + '/') ? imgPath : url(imgPath), site).href;
const homeUrl = new URL(url('/'), site).href;

const adresa = [dzamija.adresa, dzamija.grad, dzamija.drzava].some(Boolean)
  ? {
      '@type': 'PostalAddress',
      ...(dzamija.adresa && { streetAddress: dzamija.adresa }),
      ...(dzamija.grad && { addressLocality: dzamija.grad }),
      ...(dzamija.drzava && { addressCountry: dzamija.drzava }),
    }
  : undefined;
const sameAs = Object.values(dzamija.drustveneMreze).filter((v): v is string => Boolean(v));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Mosque',
  name: dzamija.naziv,
  ...(dzamija.nazivArapski && { alternateName: dzamija.nazivArapski }),
  url: homeUrl,
  image: new URL(url('/og-image.png'), site).href,
  logo: new URL(url('/favicon.svg'), site).href,
  ...(dzamija.kratakOpis && { description: dzamija.kratakOpis }),
  ...(adresa && { address: adresa }),
  ...(dzamija.koordinate?.potvrdjeno && {
    geo: { '@type': 'GeoCoordinates', latitude: dzamija.koordinate.lat, longitude: dzamija.koordinate.lng },
  }),
  ...(dzamija.kontakt.email && { email: dzamija.kontakt.email }),
  ...(dzamija.kontakt.telefon && { telephone: dzamija.kontakt.telefon }),
  ...(sameAs.length && { sameAs }),
};
---
<!doctype html>
<html lang="sr-Latn" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Tema bez bljeska: postavlja data-theme prije prvog crtanja.
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c3b2e" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content="Džamija na Jaliji — geometrijski ornament osmokrake zvijezde" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#sadrzaj">Preskoči na sadržaj</a>
    <Header />
    <main id="sadrzaj" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
