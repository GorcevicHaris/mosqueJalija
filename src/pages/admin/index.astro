---
// /admin/ — uređivanje sadržaja sajta (Supabase). noindex; izuzeto iz sitemap-a (filter u astro.config.mjs).
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminApp from '../../components/admin/AdminApp.astro';
import type { Ugradjeno } from '../../components/admin/stanje';
import { icons } from '../../components/ui/Icon.astro';
import { dove, dzamija, imami, kategorije, obavjestenja, rucnaPredavanja, serije, skrivenaPredavanja, svaPredavanja } from '../../lib/data';
import { TEKSTOVI_STRANICA } from '../../lib/tekstovi-stranica';
import { getTranskriptEnOriginal, getTranskriptOriginal } from '../../lib/transkripti';

// Podaci ugrađeni pri buildu: liste za padajuće menije i rezerva dok baza nema podatke.
const podaci: Ugradjeno = {
  imami: imami.map((i) => ({
    slug: i.slug,
    punoIme: i.punoIme,
    aliasi: i.aliasi,
    uloga: i.uloga,
    bio: i.bio,
    slika: i.slika,
    potvrdjeno: i.potvrdjeno,
    izvori: i.izvori,
  })),
  kategorije: kategorije.map((k) => ({ slug: k.slug, naziv: k.naziv, opis: k.opis })),
  serije: serije.map((s) => ({ slug: s.slug, naziv: s.naziv, opis: s.opis })),
  // sva predavanja, i skrivena (sekcije Predavanja, Ispravke, Transkripti); oznake samo kad su true
  predavanja: svaPredavanja.map((p) => ({
    id: p.id,
    naslov: p.naslov,
    naslovCist: p.naslovCist,
    datum: p.datum,
    imam: p.imam,
    kategorija: p.kategorija,
    serija: p.serija,
    serijaDio: p.serijaDio,
    ...(skrivenaPredavanja.has(p.id) ? { skriveno: true } : {}),
    ...(rucnaPredavanja.has(p.id) ? { rucno: true } : {}),
    ...(getTranskriptOriginal(p.id) ? { tr: true } : {}),
    ...(getTranskriptEnOriginal(p.id) ? { trEn: true } : {}),
  })),
  dzamija: dzamija as unknown as Record<string, unknown>,
  obavKategorije: [...new Set(obavjestenja.map((o) => o.kategorija))],
  doveKategorije: [...new Set(dove.map((d) => d.kategorija))],
  stranice: TEKSTOVI_STRANICA,
  ikone: Object.keys(icons).sort(),
  obavjestenja: obavjestenja.map((o) => ({ slug: o.slug, naslov: o.naslov })),
};
---
<BaseLayout title="Uređivanje sajta" description="Uređivanje sadržaja sajta Džamije na Jaliji (samo za urednike)." noindex>
  <AdminApp podaci={podaci} />
</BaseLayout>
