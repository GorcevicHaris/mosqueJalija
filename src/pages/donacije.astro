---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import UvodStranice from '../components/ui/UvodStranice.astro';
import { dzamija, kanaliPoruka, tekstoviStranica } from '../lib/data';

const naslovStranice = tekstoviStranica['donacije']?.naslov?.trim() || 'Donacije';
const don = dzamija.donacije;
const mreze = kanaliPoruka();

// Za donacije se javlja direktno džematu: posebni e-mail/telefon za donacije (admin), inače opšti kontakt.
const email = don.email?.trim() || dzamija.kontakt.email;
const telefon = don.telefon?.trim() || dzamija.kontakt.telefon;

const kanali = [
  mreze.instagramDm || mreze.instagram
    ? { naziv: 'Instagram', opis: 'Pošaljite poruku na Instagramu', href: (mreze.instagramDm || mreze.instagram)!, ikona: 'instagram' as const, vani: true }
    : null,
  mreze.facebook
    ? { naziv: 'Facebook', opis: 'Pišite nam na Facebook stranici', href: mreze.facebook, ikona: 'facebook' as const, vani: true }
    : null,
  telefon
    ? { naziv: telefon, opis: 'Pozovite telefonom', href: `tel:${telefon.replace(/[^\d+]/g, '')}`, ikona: 'phone' as const, vani: false }
    : null,
  email
    ? {
        naziv: email,
        opis: 'Pošaljite e-mail',
        href: `mailto:${email}?subject=${encodeURIComponent('Donacija za džamiju')}`,
        ikona: 'mail' as const,
        vani: false,
      }
    : null,
].filter((k) => k !== null);
---
<BaseLayout title={naslovStranice} description="Podržite rad Džamije na Jaliji. Za donaciju se javite džematu na Instagramu, Facebooku, telefonom ili e-mailom.">
  <PageHero eyebrow="Sadaka i vakuf" title={naslovStranice} subtitle="Za donaciju se javite direktno džematu." arabic="مَا نَقَصَتْ صَدَقَةٌ مِنْ مَالٍ" />

  <section class="section" aria-labelledby="kontakt-donacije">
    <div class="container container--narrow">
      <UvodStranice kljuc="donacije" />
      <h2 id="kontakt-donacije" class="don__h">Javite nam se</h2>
      {kanali.length ? (
        <ul class="don__lista" role="list">
          {kanali.map((k) => (
            <li>
              <a class="don__kanal" href={k.href} {...(k.vani ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="don__ikona"><Icon name={k.ikona} size={22} /></span>
                <span class="don__tekst">
                  <span class="don__naziv">{k.naziv}</span>
                  <span class="don__opis">{k.opis}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">Kontakt za donacije još nije objavljen.</p>
      )}
      {don.napomena && <p class="don__napomena muted">{don.napomena}</p>}
      <p class="don__hadis muted">„Sadaka ne umanjuje imetak.“ — hadis, bilježi Muslim</p>
    </div>
  </section>
</BaseLayout>

<style>
  .don__h { font-size: clamp(1.25rem, 0.8vw + 1rem, 1.5rem); margin: 0 0 var(--space-4); }
  .don__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .don__kanal {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition);
  }
  .don__kanal:hover { border-color: var(--color-primary); background: var(--color-surface-2); }
  .don__ikona {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    color: var(--color-primary);
  }
  .don__tekst { display: grid; gap: 2px; min-width: 0; }
  .don__naziv { font-weight: 700; overflow-wrap: anywhere; }
  .don__opis { font-size: 0.9rem; color: var(--color-text-muted); }
  .don__napomena { margin: var(--space-5) 0 0; }
  .don__hadis { margin: var(--space-6) 0 0; font-family: var(--font-serif); font-size: 1.05rem; }
</style>
