---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import LectureCard from '../../components/predavanja/LectureCard.astro';
import ImamAvatar from '../../components/predavanja/ImamAvatar.astro';
import { imami, predavanja, getKategorija } from '../../lib/data';
import { filterQuery } from '../../lib/predavanja';
import { oblik } from '../../lib/format';
import { url } from '../../lib/url';
import type { Imam } from '../../lib/types';

export function getStaticPaths() {
  return imami.map((i) => ({ params: { slug: i.slug }, props: { imam: i } }));
}
interface Props { imam: Imam }
const { imam } = Astro.props;

const njegova = predavanja.filter((p) => p.imam === imam.slug);
const PRIKAZ = 12;
const poKategoriji = Object.entries(
  njegova.reduce<Record<string, number>>((acc, p) => ((acc[p.kategorija] = (acc[p.kategorija] ?? 0) + 1), acc), {}),
).sort((a, b) => b[1] - a[1]);
const opis =
  imam.bio?.slice(0, 155) ??
  `${imam.punoIme} — ${njegova.length} ${oblik(njegova.length, 'snimak', 'snimka', 'snimaka')} (hutbe i predavanja) u Džamiji na Jaliji.`;
---
<BaseLayout title={imam.punoIme} description={opis}>
  <section class="im-hero theme-inverse pattern-bg">
    <div class="container im-hero__inner">
      <ImamAvatar punoIme={imam.punoIme} slika={imam.slika} size={128} />
      <div>
        <p class="eyebrow"><a href={url('/imami')}>Imami i predavači</a></p>
        <h1 class="im-hero__name">{imam.punoIme}</h1>
        {imam.uloga && <p class="im-hero__role">{imam.uloga}</p>}
        <p class="im-hero__count">{njegova.length} {oblik(njegova.length, 'snimak', 'snimka', 'snimaka')} na sajtu</p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container im-body">
      <div class="im-bio">
        <h2 class="im-h2">O predavaču</h2>
        {imam.bio ? (
          <div class="prose"><p>{imam.bio}</p></div>
        ) : (
          <Placeholder label={`biografija (${imam.punoIme})`} hint="podaci će biti dodani nakon provjere" />
        )}
        {imam.izvori.length > 0 && (
          <div class="im-izvori">
            <h3>Izvori</h3>
            <ul>
              {imam.izvori.map((iz) => (
                <li>{iz.url ? <a href={iz.url} target="_blank" rel="noopener">{iz.naziv}</a> : iz.naziv}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
      {poKategoriji.length > 0 && (
        <aside class="im-kat card" aria-labelledby="im-kat-naslov">
          <h2 class="im-h3" id="im-kat-naslov">Po kategorijama</h2>
          <ul>
            {poKategoriji.map(([k, n]) => (
              <li>
                <a href={url(`/predavanja${filterQuery({ imam: imam.slug, kategorija: k })}`)}>{getKategorija(k)?.naziv ?? k}</a>
                <span class="badge badge--muted">{n}</span>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </section>

  <section class="section section--tint section--tight" aria-labelledby="im-pred">
    <div class="container">
      <div class="im-pred-head">
        <h2 id="im-pred">Najnovija predavanja i hutbe</h2>
        {njegova.length > 0 && (
          <a class="btn btn--primary" href={url(`/predavanja${filterQuery({ imam: imam.slug })}`)}>Sva predavanja ({njegova.length})</a>
        )}
      </div>
      {njegova.length === 0 ? (
        <p class="muted">Još nema objavljenih snimaka ovog predavača.</p>
      ) : (
        <div class="grid-cards">
          {njegova.slice(0, PRIKAZ).map((p) => <LectureCard predavanje={p} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .im-hero { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .im-hero__inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5) var(--space-6); }
  .im-hero .eyebrow a { color: inherit; }
  .im-hero__name { color: var(--inverse-text); margin: var(--space-1) 0; font-size: clamp(1.8rem, 3vw + 1rem, 2.8rem); }
  .im-hero__role { color: var(--inverse-muted); margin: 0; font-size: 1.08rem; }
  .im-hero__count { color: var(--inverse-accent); margin: var(--space-2) 0 0; font-weight: 700; }
  .im-body { display: grid; gap: var(--space-6); }
  @media (min-width: 900px) { .im-body { grid-template-columns: minmax(0, 1fr) 300px; align-items: start; } }
  .im-h2 { margin-top: 0; }
  .im-h3 { font-size: 1.1rem; margin: 0 0 var(--space-3); }
  .im-izvori { margin-top: var(--space-6); font-size: 0.9rem; }
  .im-izvori h3 { font-size: 1rem; margin-bottom: var(--space-2); }
  .im-izvori ul { padding-left: 1.2em; margin: 0; display: grid; gap: var(--space-1); }
  .im-kat ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .im-kat li { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .im-pred-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-3); margin-bottom: var(--space-5); }
  .im-pred-head h2 { margin: 0; }
</style>
