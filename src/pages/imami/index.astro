---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ImamAvatar from '../../components/predavanja/ImamAvatar.astro';
import { imami } from '../../lib/data';
import { oblik } from '../../lib/format';
import { url } from '../../lib/url';

const lista = imami.filter((i) => i.brojPredavanja > 0 || i.bio);
---
<BaseLayout
  title="Imami i predavači"
  description="Imami, hatibi i predavači čije su hutbe i predavanja objavljeni na YouTube kanalu Džamije na Jaliji."
>
  <PageHero
    eyebrow="Džemat"
    title="Imami i predavači"
    subtitle="Hatibi i predavači čije hutbe, predavanja i halke možete pogledati na sajtu."
  />
  <section class="section section--tight">
    <div class="container">
      {lista.length === 0 ? (
        <p class="muted">Još nema podataka o predavačima.</p>
      ) : (
        <ul class="grid-cards im-grid" role="list">
          {lista.map((i) => (
            <li class="card im-card">
              <ImamAvatar punoIme={i.punoIme} slika={i.slika} size={88} />
              <h2 class="im-card__name card__title">
                <a href={url(`/imami/${i.slug}`)}>{i.punoIme}</a>
              </h2>
              {i.uloga ? <p class="im-card__role">{i.uloga}</p> : <p class="im-card__role muted">Predavač</p>}
              <p class="im-card__count">
                <strong>{i.brojPredavanja}</strong> {oblik(i.brojPredavanja, 'snimak', 'snimka', 'snimaka')}
              </p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .im-grid { list-style: none; margin: 0; padding: 0; }
  .im-card { align-items: center; text-align: center; gap: var(--space-2); padding-top: var(--space-6); }
  .im-card:hover { box-shadow: var(--shadow-md); border-color: var(--color-border-strong); }
  .im-card__name { margin: var(--space-3) 0 0; font-size: 1.15rem; }
  .im-card__role { margin: 0; font-size: 0.92rem; color: var(--color-text-muted); }
  .im-card__count {
    margin: var(--space-2) 0 0;
    padding: 0.2rem 0.8rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-2);
    font-size: 0.88rem;
  }
</style>
