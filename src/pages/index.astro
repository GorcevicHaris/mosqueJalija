---
import BaseLayout from '../layouts/BaseLayout.astro';
import LectureCard from '../components/predavanja/LectureCard.astro';
import VaktijaToday from '../components/vaktija/VaktijaToday.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import StatTile from '../components/ui/StatTile.astro';
import Icon from '../components/ui/Icon.astro';
import StarEmblem from '../components/ui/StarEmblem.astro';
import AjetHadisDana from '../components/ui/AjetHadisDana.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import DanasUDzamiji from '../components/obrasci/DanasUDzamiji.astro';
import { naslovnaSlika as dajNaslovnu, varijanta } from '../lib/slike';
import { url } from '../lib/url';
import { dzamija, predavanja, obavjestenja, imami, galerija, formatDatum, punaAdresa } from '../lib/data';

const najnovija = predavanja.slice(0, 6);
const brojHutbi = predavanja.filter((p) => p.kategorija === 'hutba').length;
const aktuelno = obavjestenja.slice(0, 3);
const istaknutiImami = imami.slice(0, 4);
// na početnoj kratko: bez pojašnjenja u zagradi ("8. mart 2024." umjesto "8. mart 2024. (uoči ramazana …)")
const cinjenice = dzamija.cinjenice
  .map((c) => ({ ...c, vrijednost: c.vrijednost.replace(/\s*\([^)]*\)\s*$/, '') }))
  .filter((c) => c.oznaka !== 'Adresa' && c.vrijednost.length <= 40)
  .slice(0, 3);
const prvaHistorija = dzamija.historija[0] ?? null;
const hero = dajNaslovnu();
// Fotografija u okviru "O džamiji": prva iz galerije koja nije ista kao naslovna (dron-fotografija s otvaranja).
const naslovnaSlika = galerija.find((g) => !/dzamija-iz-drona|dzamija-hero/.test(g.src) && g.src !== dzamija.naslovnaSlika) ?? galerija[0] ?? null;
const imgSrc = (src: string) => (/^https?:/.test(src) ? src : url(src));
/** Mala varijanta (<ime>-200.webp) za avatare, ako postoji. */
const avatarSrc = (src: string) => imgSrc(varijanta(src, '200') ?? src);
/** Sličica galerije (<ime>-600.webp), ako postoji. */
const galSrc = (src: string) => imgSrc(varijanta(src, '600') ?? src);
const inicijali = (ime: string) =>
  ime
    .replace(/\b(hfz|ef|mr|dr|prof|muftija|kurra)\.?\b/gi, '')
    .split(/\s+/)
    .filter((w) => /^[A-ZČĆĐŠŽ]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join('');
const mjesto = [dzamija.grad, dzamija.drzava].filter(Boolean).join(', ');

const korisno = [
  { naslov: 'Mekteb i halke', opis: 'Vjerska pouka za djecu i halke za odrasle.', href: '/mekteb', ikona: 'graduation' as const },
  { naslov: 'Online upis', opis: "Prijava u mekteb, halke, Školu Kur'ana ili sufaru.", href: '/upis', ikona: 'check' as const },
  { naslov: 'Sedmični raspored', opis: 'Termini halki, mekteba i kurseva po danima.', href: '/raspored', ikona: 'calendar' as const },
  { naslov: 'Pitaj imama', opis: 'Postavite pitanje o vjeri — i anonimno.', href: '/pitaj-imama', ikona: 'message' as const },
  { naslov: 'Dove', opis: "Dove iz Kur'ana i sunneta, sa prevodom.", href: '/dove', ikona: 'hands' as const },
  { naslov: "Kur'an i hadisi", opis: 'Ajet i hadis dana, sa izvorima.', href: '/kuran-hadisi', ikona: 'book-quran' as const },
  { naslov: "Učenje Kur'ana", opis: 'Koraci za početnike i provjereni izvori.', href: '/ucenje-kurana', ikona: 'book' as const },
  { naslov: 'Pravila ponašanja', opis: 'Adab u džamiji.', href: '/pravila-ponasanja', ikona: 'door' as const },
];
---
<BaseLayout title="Džamija na Jaliji" image={dzamija.naslovnaSlika && /^https?:/.test(dzamija.naslovnaSlika) ? dzamija.naslovnaSlika : undefined}>
  {hero && <link slot="head" rel="preload" as="image" href={hero.src} imagesrcset={hero.srcset} imagesizes={hero.srcset ? '100vw' : undefined} fetchpriority="high" />}
  <!-- ================= HERO ================= -->
  <section class:list={['hero theme-inverse pattern-bg', { 'hero--foto': hero }]} aria-labelledby="hero-naslov">
    {hero && (
      <img class="hero__photo" src={hero.src} srcset={hero.srcset} sizes={hero.srcset ? '100vw' : undefined} alt="" width="2000" height="1100" fetchpriority="high" decoding="async" />
    )}
    {hero && <div class="hero__shade" aria-hidden="true"></div>}
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="hero__bismillah calligraphy" lang="ar" dir="rtl">بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ</p>
        <p class="eyebrow">{mjesto ? `Džemat · ${mjesto}` : 'Dobro došli u naš džemat'}</p>
        <h1 id="hero-naslov" class="hero__title">Džamija <span>na Jaliji</span></h1>
        {dzamija.kratakOpis ? (
          <p class="hero__lead">{dzamija.kratakOpis}</p>
        ) : (
          <>
            <p class="hero__lead">Predavanja i hutbe, vaktija, obavještenja i korisni sadržaji za džemat — na jednom mjestu.</p>
            <Placeholder label="kratak opis džamije (lokacija, historija u dvije rečenice)" />
          </>
        )}
        <div class="hero__cta">
          <a class="btn btn--gold" href={url('/predavanja')}><Icon name="play" size={18} /> Predavanja</a>
          <a class="btn btn--ghost" href={url('/vaktija')}><Icon name="clock" size={18} /> Vaktija</a>
        </div>
        {predavanja.length > 0 && (
          <ul class="hero__facts" role="list">
            <li><strong>{predavanja.length}</strong> snimaka na kanalu</li>
            {brojHutbi > 0 && <li><strong>{brojHutbi}</strong> hutbi</li>}
            {imami.length > 0 && <li><strong>{imami.length}</strong> {imami.length === 1 ? 'predavač' : 'predavača'}</li>}
          </ul>
        )}
      </div>

      <aside class="hero__arch" aria-labelledby="vaktija-naslov">
        <div class="hero__arch-inner">
          <div class="hero__arch-head">
            <StarEmblem size={34} />
            <div>
              <h2 id="vaktija-naslov" class="hero__arch-title">Namaska vremena</h2>
              <p class="hero__arch-sub">Današnja vaktija</p>
            </div>
          </div>
          <VaktijaToday compact />
          <div class="hero__arch-foot">
            <p class="hero__dzuma">
              <Icon name="calendar" size={16} />
              <span>Džuma: {dzamija.dzuma.vrijeme ?? <Placeholder inline label="vrijeme džume" />}</span>
            </p>
            <a class="link-arrow" href={url('/vaktija')}>Mjesečna vaktija</a>
          </div>
        </div>
      </aside>
    </div>
    {hero?.izvor && <p class="hero__credit">{hero.izvor}</p>}
    <div class="hero__arcade" aria-hidden="true"></div>
  </section>

  <DanasUDzamiji />

  <!-- ================= PREDAVANJA ================= -->
  <section class="section" aria-labelledby="predavanja-naslov">
    <div class="container">
      <SectionHeading id="predavanja-naslov" eyebrow="Sa YouTube kanala" title="Najnovija predavanja" lead="Predavanja, hutbe i tefsirske serije imama i gostiju džamije.">
        <Fragment slot="action">
          <a class="btn btn--ghost btn--sm" href={url('/hutbe')}>Hutbe</a>
          <a class="btn btn--primary btn--sm" href={url('/predavanja')}>Sva predavanja <Icon name="arrow-right" size={16} /></a>
        </Fragment>
      </SectionHeading>
      {najnovija.length ? (
        <div class="grid-cards">
          {najnovija.map((p) => <LectureCard predavanje={p} />)}
        </div>
      ) : (
        <Placeholder label="predavanja sa YouTube kanala" hint="pokrenuti skriptu za preuzimanje videa" />
      )}
    </div>
  </section>

  <!-- ================= AKTUELNO ================= -->
  <section class="section section--tint pattern-bg pattern-bg--fade" aria-labelledby="aktuelno-naslov">
    <div class="container">
      <SectionHeading id="aktuelno-naslov" eyebrow="Aktuelno" title="Obavještenja">
        <a slot="action" class="link-arrow" href={url('/obavjestenja')}>Sva obavještenja</a>
      </SectionHeading>
      <div data-news>
      {aktuelno.length ? (
        <ul class="news" role="list">
          {aktuelno.map((o) => (
            <li class="news__item card card--link">
              <div class="news__meta">
                <time datetime={o.datum}>{formatDatum(o.datum)}</time>
                <span class="badge">{o.kategorija}</span>
                {o.placeholder && <span class="badge badge--warn">Primjer sadržaja</span>}
              </div>
              <h3 class="card__title news__title">
                <a href={url(`/obavjestenja/${o.slug}`)}>{o.naslov}</a>
              </h3>
              <p class="news__excerpt">{o.sazetak}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="card empty">
          <Icon name="bell" size={28} />
          <p><strong>Trenutno nema novih obavještenja.</strong></p>
          <p class="muted">Najave predavanja, halki i aktivnosti džemata objavljivaće se ovdje.</p>
          <a class="link-arrow" href={url('/objave')}>Pogledajte objave</a>
        </div>
      )}
      </div>
    </div>
  </section>

  <!-- ================= AJET / HADIS DANA ================= -->
  <section class="section section--tight" aria-label="Ajet / hadis dana">
    <div class="container container--narrow ahd-col">
      <AjetHadisDana naslov="Ajet / hadis dana" />
      <a class="link-arrow ahd-col__link" href={url('/kuran-hadisi')}>Kur'an i hadisi</a>
    </div>
  </section>

  <!-- ================= O DŽAMIJI ================= -->
  <section class="section section--tint" aria-labelledby="o-dzamiji-naslov">
    <div class="container container--narrow about">
      <p class="eyebrow">O džamiji</p>
      <h2 id="o-dzamiji-naslov">Kuća namaza, znanja i zajedništva</h2>
      {prvaHistorija ? (
        <p class="about__p">{prvaHistorija.tekst.length > 420 ? prvaHistorija.tekst.slice(0, 420).replace(/\s\S*$/, '') + '…' : prvaHistorija.tekst}</p>
      ) : (
        <Placeholder label="historija džamije (godina izgradnje, graditelj, obnove)" hint="sa izvorima" />
      )}
      {cinjenice.length ? (
        <div class="about__stats">
          {cinjenice.map((c) => <StatTile value={c.vrijednost} label={c.oznaka} source={c.izvor} />)}
        </div>
      ) : null}
      {naslovnaSlika && (
        <figure class="about__photo">
          <img src={galSrc(naslovnaSlika.src)} alt={naslovnaSlika.alt} loading="lazy" decoding="async" width="600" height="760" />
        </figure>
      )}
      <div class="about__links">
        <a class="btn btn--primary" href={url('/o-dzamiji')}>Historija džamije</a>
        <a class="btn btn--ghost" href={url('/galerija')}><Icon name="image" size={18} /> Galerija</a>
      </div>
    </div>
  </section>

  <!-- ================= IMAMI ================= -->
  {istaknutiImami.length > 0 && (
    <section class="section" aria-labelledby="imami-naslov">
      <div class="container">
        <SectionHeading id="imami-naslov" eyebrow="Imami i predavači" title="Ko drži predavanja">
          <a slot="action" class="link-arrow" href={url('/imami')}>Svi imami i predavači</a>
        </SectionHeading>
        <ul class="imami grid-cards grid-cards--sm" role="list">
          {istaknutiImami.map((i) => (
            <li class="card card--link imam">
              {i.slika ? (
                <img class="imam__avatar" src={avatarSrc(i.slika)} alt="" width="76" height="76" loading="lazy" decoding="async" />
              ) : (
                <span class="imam__avatar imam__avatar--initials" aria-hidden="true">{inicijali(i.punoIme) || '•'}</span>
              )}
              <h3 class="card__title imam__name"><a href={url(`/imami/${i.slug}`)}>{i.punoIme}</a></h3>
              <p class="imam__role">
                {i.uloga ?? <span class="muted">Predavač</span>}
                {!i.potvrdjeno && <span class="badge badge--muted">nepotvrđeno</span>}
              </p>
              <p class="card__meta">{i.brojPredavanja} {i.brojPredavanja === 1 ? 'snimak' : 'snimaka'}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ================= KORISNO ================= -->
  <section class="section section--tint pattern-bg pattern-bg--fade" aria-labelledby="korisno-naslov">
    <div class="container">
      <SectionHeading id="korisno-naslov" eyebrow="Edukacija" title="Mekteb, halke i korisni sadržaji" align="center" lead="Vjerska pouka, prijave i korisni sadržaji za svaki uzrast." />
      <ul class="grid-cards korisno" role="list">
        {korisno.map((k) => (
          <li class="card card--link">
            <span class="card__icon"><Icon name={k.ikona} size={24} /></span>
            <h3 class="card__title"><a href={url(k.href)}>{k.naslov}</a></h3>
            <p class="muted">{k.opis}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= DONACIJE ================= -->
  <section class="donate theme-inverse pattern-bg" aria-labelledby="donacije-naslov">
    <div class="container donate__inner">
      <div class="donate__text">
        <p class="eyebrow">Sadaka i vakuf</p>
        <h2 id="donacije-naslov">Podržite rad džamije</h2>
        <p>Vaši prilozi pomažu održavanje džamije, rad mekteba i halki, te aktivnosti džemata.</p>
        <figure class="donate__hadith">
          <blockquote>
            <p lang="ar" dir="rtl" class="donate__ar">مَا نَقَصَتْ صَدَقَةٌ مِنْ مَالٍ</p>
            <p>„Sadaka ne umanjuje imetak.“</p>
          </blockquote>
          <figcaption>Hadis, bilježi Muslim</figcaption>
        </figure>
      </div>
      <div class="donate__actions">
        <a class="btn btn--gold" href={url('/donacije')}><Icon name="heart" size={18} /> Doniraj</a>
      </div>
    </div>
  </section>

  <!-- ================= PRATITE NAS + POSJETITE NAS ================= -->
  <section class="section" aria-labelledby="pratite-naslov">
    <div class="container">
      <SectionHeading id="pratite-naslov" eyebrow="Pratite nas" title="Budite u toku sa džematom">
        <a slot="action" class="link-arrow" href={url('/mediji')}>Mediji</a>
      </SectionHeading>
      <SocialLinks variant="cards" />
      <div class="visit card">
        <div class="visit__icon"><Icon name="map-pin" size={26} /></div>
        <div class="visit__body">
          <h3>Posjetite nas</h3>
          {[dzamija.adresa, dzamija.grad].some(Boolean) ? (
            <p>{punaAdresa()}</p>
          ) : (
            <Placeholder label="tačna adresa džamije" />
          )}
        </div>
        <a class="btn btn--primary" href={url('/kontakt')}>Kontakt i mapa</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Sekcije ispod prvog ekrana se iscrtavaju tek kad im se korisnik približi: pregledač ne računa
     raspored i ne preuzima fontove za njih (npr. arapski Amiri za ajet dana) prije prvog prikaza. */
  :global(#sadrzaj) > section:not(.hero) {
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3.5rem, 8vw, 6rem);
  }
  /* naslovna fotografija: ispod smaragdnog sloja i girih uzorka (kontrast teksta ostaje AA) */
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 32% 45%;
    filter: saturate(0.8);
  }
  @media (max-width: 959.98px) {
    /* uzak, visok hero: fotografija samo u gornjem dijelu (manje uvećanje), blago se gubi prema dnu */
    .hero__photo {
      height: min(620px, 75%);
      object-position: 30% 40%;
      -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
      mask-image: linear-gradient(to bottom, #000 55%, transparent);
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(100deg,
        color-mix(in srgb, var(--inverse-bg) 92%, transparent) 0%,
        color-mix(in srgb, var(--inverse-bg) 84%, transparent) 55%,
        color-mix(in srgb, var(--inverse-bg) 80%, transparent) 100%),
      linear-gradient(to top, var(--inverse-bg) 0%, transparent 35%);
  }
  .hero--foto .hero__arch-inner { background: color-mix(in srgb, var(--inverse-bg) 72%, transparent); }
  .hero__credit {
    position: absolute;
    right: var(--space-4);
    bottom: 26px;
    margin: 0;
    font-size: 0.72rem;
    color: var(--inverse-muted);
    max-width: calc(100% - 2 * var(--space-4));
    text-align: right;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 78% 40%, rgb(40 130 100 / 0.45), transparent 70%),
      radial-gradient(ellipse 50% 50% at 10% 0%, rgb(226 191 110 / 0.12), transparent 70%);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: 1.15fr 0.85fr; gap: var(--space-8); }
  }
  .hero__bismillah {
    font-size: clamp(1.9rem, 3.6vw + 0.8rem, 3.1rem);
    color: var(--inverse-accent);
    margin: 0 0 var(--space-3);
    text-align: left;
    direction: rtl;
    unicode-bidi: plaintext;
  }
  .hero__title {
    font-size: clamp(2.5rem, 6vw + 0.5rem, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
    color: var(--inverse-text);
  }
  .hero__title span { display: block; color: var(--inverse-accent); font-style: italic; font-weight: 500; }
  .hero__lead {
    font-size: clamp(1.08rem, 0.6vw + 1rem, 1.25rem);
    color: var(--inverse-muted);
    max-width: 52ch;
  }
  .hero__text :global(.placeholder) { max-width: 52ch; margin-bottom: var(--space-4); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .hero__cta .btn--ghost { --btn-fg: var(--inverse-text); --btn-border: rgb(246 239 221 / 0.4); }
  .hero__cta .btn--ghost:hover { --btn-bg: rgb(246 239 221 / 0.08); --btn-border: var(--inverse-accent); }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
    color: var(--inverse-muted);
    font-size: 0.92rem;
  }
  .hero__facts strong { color: var(--inverse-text); font-family: var(--font-serif); font-size: 1.35rem; margin-right: 0.25em; }

  .hero__arch {
    position: relative;
    padding: 10px;
    border-radius: 220px 220px var(--radius-lg) var(--radius-lg);
    border: 1.5px solid rgb(226 191 110 / 0.7);
    max-width: 460px;
    width: 100%;
    justify-self: center;
  }
  .hero__arch::before {
    /* zvijezda na vrhu luka */
    content: '';
    position: absolute;
    top: -13px;
    left: 50%;
    width: 26px;
    height: 26px;
    transform: translateX(-50%);
    background: var(--inverse-accent);
    -webkit-mask: var(--ornament-star) center / contain no-repeat;
    mask: var(--ornament-star) center / contain no-repeat;
  }
  .hero__arch-inner {
    border-radius: 210px 210px calc(var(--radius-lg) - 4px) calc(var(--radius-lg) - 4px);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.03));
    border: 1px solid rgb(226 191 110 / 0.25);
    padding: clamp(3.5rem, 8vw, 4.5rem) clamp(1rem, 3vw, 1.75rem) var(--space-5);
    backdrop-filter: blur(3px);
  }
  .hero__arch-head { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); text-align: center; margin-bottom: var(--space-4); }
  .hero__arch-title { font-size: 1.5rem; margin: 0; color: var(--inverse-text); }
  .hero__arch-sub { margin: 0; font-size: 0.85rem; color: var(--inverse-muted); letter-spacing: 0.08em; text-transform: uppercase; }
  .hero__arch-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(226 191 110 / 0.25);
    font-size: 0.92rem;
  }
  .hero__dzuma { display: inline-flex; align-items: center; gap: var(--space-2); margin: 0; color: var(--inverse-muted); }
  .hero__dzuma :global(svg) { color: var(--inverse-accent); flex: none; }
  .hero__arch-foot .link-arrow { color: var(--inverse-accent); }
  .hero__arcade {
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 18px;
    background: radial-gradient(circle at 50% 100%, var(--page-bg) 12px, transparent 12.5px) 0 0 / 34px 18px repeat-x;
  }

  /* ---------- Obavještenja ---------- */
  /* :global — stavke dodaje i skripta (nova obavještenja iz admina) bez Astro atributa opsega */
  [data-news] :global(.news) {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: var(--space-5);
  }
  [data-news] :global(.news__item) { padding: var(--space-5); }
  [data-news] :global(.news__meta) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); font-size: 0.86rem; color: var(--color-text-muted); margin-bottom: var(--space-2); }
