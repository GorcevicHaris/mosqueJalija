---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import KontaktSupabase from '../components/obrasci/KontaktSupabase.astro';
import { url } from '../lib/url';
import { dzamija, zaglavljeStranice } from '../lib/data';
import { lokacija } from '../lib/lokacija';

const { potvrdjeno } = lokacija;
// Sve mape vode na Google Maps (ugrađena mapa, "Otvori" i navigacija) — src/lib/lokacija.ts.
const gEmbed = lokacija.embed(17);
const gmaps = lokacija.otvori;
const gnav = lokacija.navigacija;
const adresa = [dzamija.adresa, dzamija.drzava].filter(Boolean).join(', ');
const k = dzamija.kontakt;
const m = dzamija.drustveneMreze;
const mreze = [
  { naziv: 'YouTube', url: m.youtube },
  { naziv: 'Facebook', url: m.facebook },
  { naziv: 'Instagram', url: m.instagram },
];
// Naslov i podnaslov zaglavlja: admin → Tekstovi stranica (prazno = ugrađeno, src/lib/tekstovi-stranica.ts).
const zaglavlje = zaglavljeStranice('kontakt', { podnaslov: adresa || dzamija.naziv });
---
<BaseLayout title="Kontakt" description={`Kontakt i lokacija: ${dzamija.naziv}${adresa ? `, ${adresa}` : ''}. Mapa, navigacija, društvene mreže i kontakt forma.`}>
  <PageHero eyebrow="Kontakt i lokacija" title={zaglavlje.naslov} subtitle={zaglavlje.podnaslov} />

  <section class="section" aria-labelledby="adresa-naslov">
    <div class="container container--narrow kt">
      <h2 id="adresa-naslov" class="flow__h">Adresa</h2>
      {adresa ? <p class="kt__big">{adresa}</p> : <Placeholder label="adresa džamije" />}
      {!potvrdjeno && <p class="muted kt__small">Lokacija na mapi je približna (nije potvrđena).</p>}
      <div class="kt__btns">
        <a class="btn btn--primary" href={gnav} target="_blank" rel="noopener">Navigacija do džamije</a>
        <a class="btn btn--ghost" href={gmaps} target="_blank" rel="noopener">Otvori u Google Maps</a>
        <a class="btn btn--ghost" href={url('/lokacija')}>Stranica lokacije</a>
      </div>

      <div class="kt__frame">
        <iframe
          src={gEmbed}
          title={`Mapa: lokacija — ${dzamija.naziv}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <h2 class="visually-hidden">Kontakt podaci</h2>
      <dl class="kt__dl">
        <div>
          <dt>E-mail</dt>
          <dd>{k.email ? <a href={`mailto:${k.email}`}>{k.email}</a> : <Placeholder label="e-mail džamije" inline />}</dd>
        </div>
        <div>
          <dt>Telefon</dt>
          <dd>{k.telefon ? <a href={`tel:${k.telefon.replace(/[^\d+]/g, '')}`}>{k.telefon}</a> : <Placeholder label="telefon džamije" inline />}</dd>
        </div>
        <div>
          <dt>Džuma-namaz</dt>
          <dd>
            {dzamija.dzuma.vrijeme ? <span>{dzamija.dzuma.vrijeme}</span> : <Placeholder label="vrijeme džume" inline />}
            {dzamija.dzuma.napomena && <span class="muted"> — {dzamija.dzuma.napomena}</span>}
            <a class="kt__inline" href={url('/vaktija')}>Vaktija</a>
          </dd>
        </div>
        <div>
          <dt>Mreže</dt>
          <dd>
            <ul class="kt__mreze">
              {mreze.map((x) => (
                <li>
                  {x.url ? (
                    <a href={x.url} target="_blank" rel="noopener">{x.naziv}</a>
                  ) : (
                    <Placeholder label={`${x.naziv} profil`} inline />
                  )}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
      {k.napomena && <p class="muted kt__small">{k.napomena}</p>}
    </div>
  </section>

  <section class="section section--tint section--tight" aria-labelledby="forma-naslov">
    <div class="container container--narrow">
      <h2 id="forma-naslov">Pošaljite poruku</h2>
      <p class="muted">
        Za upis koristite <a href={url('/upis')}>online upis</a>, a vjerska pitanja postavite na stranici <a href={url('/pitaj-imama')}>Pitaj imama</a>.
      </p>
      <div class="card kt__form">
        <KontaktSupabase />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .kt > * { margin: 0; }
  .kt { display: grid; gap: var(--space-4); }
  .kt__big { font-size: 1.15rem; font-weight: 600; }
  .kt__small { font-size: 0.88rem; }
  .kt__btns { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .kt__frame {
    margin-top: var(--space-3) !important;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    background: var(--color-surface-2);
  }
  .kt__frame iframe { width: 100%; height: 100%; border: 0; display: block; }
  .kt__dl { margin-top: var(--space-4) !important; border-top: 1px solid var(--color-border); }
  .kt__dl > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-1) var(--space-4);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  @media (max-width: 480px) { .kt__dl > div { grid-template-columns: 1fr; } }
  .kt__dl dt { font-weight: 700; font-size: 0.9rem; color: var(--color-text-muted); }
  .kt__dl dd { margin: 0; overflow-wrap: anywhere; }
  .kt__inline { margin-left: var(--space-3); font-weight: 600; font-size: 0.92rem; }
  .kt__mreze { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); font-weight: 600; }
  .kt__form { margin-top: var(--space-4); }
</style>
