---
// Lokacija džamije: velika Google mapa, adresa, navigacija. Sve mape vode na Google Maps.
// "Kako doći" se prikazuje samo kad urednik upiše tekst (admin → Tekstovi stranica → "Lokacija — kako doći").
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import CopyButton from '../components/ui/CopyButton.astro';
import Icon from '../components/ui/Icon.astro';
import { url } from '../lib/url';
import { dzamija, tekstStranice, zaglavljeStranice } from '../lib/data';
import { lokacija } from '../lib/lokacija';
import { naslovnaSlika } from '../lib/slike';

const { adresa, potvrdjeno, lat, lng } = lokacija;
const zaglavlje = zaglavljeStranice('lokacija', { podnaslov: adresa || dzamija.naziv });
const kakoDoci = tekstStranice('lokacija-kako-doci')?.paragrafi ?? [];
const foto = naslovnaSlika();
const koordinate = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
---
<BaseLayout
  title="Lokacija"
  description={`Lokacija: ${dzamija.naziv}${adresa ? `, ${adresa}` : ''}. Mapa, navigacija do džamije i Google Maps.`}
  image={dzamija.naslovnaSlika ?? undefined}
>
  <PageHero eyebrow="Kako do nas" title={zaglavlje.naslov} subtitle={zaglavlje.podnaslov} />

  <section class="section section--tight" aria-labelledby="lok-adresa">
    <div class="container lok">
      <div class="lok__info card">
        <p class="lok__pin" aria-hidden="true"><Icon name="map-pin" size={26} /></p>
        <h2 id="lok-adresa" class="lok__h">Adresa</h2>
        {adresa ? <p class="lok__adresa">{adresa}</p> : <Placeholder label="adresa džamije" />}
        {!potvrdjeno && <p class="muted lok__small">Lokacija na mapi je približna (nije potvrđena).</p>}
        <div class="lok__btns">
          <a class="btn btn--primary btn--block lok__btn" href={lokacija.navigacija} target="_blank" rel="noopener">
            <Icon name="navigation" size={20} /> Navigacija do džamije
          </a>
          <a class="btn btn--ghost btn--block lok__btn" href={lokacija.otvori} target="_blank" rel="noopener">
            <Icon name="external" size={18} /> Otvori u Google Maps
          </a>
        </div>
        <p class="lok__small muted">Dugmad otvaraju Google Maps (na telefonu aplikaciju, ako je instalirana).</p>
        <div class="lok__koord">
          <span><span class="lok__label">Koordinate</span> <span class="lok__mono">{koordinate}</span></span>
          <CopyButton text={koordinate} label="Kopiraj" />
        </div>
      </div>

      <div class="lok__map">
        <iframe
          src={lokacija.embed(17)}
          title={`Google mapa: lokacija — ${dzamija.naziv}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  {kakoDoci.length > 0 && (
    <section class="section section--tight section--tint" aria-labelledby="lok-kako">
      <div class="container container--narrow">
        <h2 id="lok-kako">Kako doći</h2>
        <div class="prose">{kakoDoci.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>
  )}

  <section class="section section--tight" aria-labelledby="lok-vise">
    <div class="container lok-dno">
      {foto && (
        <figure class="lok__foto">
          <img
            src={foto.src}
            srcset={foto.srcset}
            sizes={foto.srcset ? '(min-width: 1240px) 1200px, 100vw' : undefined}
            alt={`${dzamija.naziv}${dzamija.grad ? `, ${dzamija.grad}` : ''}`}
            width="2000"
            height="1100"
            loading="lazy"
            decoding="async"
          />
          {foto.izvor && <figcaption>{foto.izvor}</figcaption>}
        </figure>
      )}
      <nav class="lok__vise" aria-labelledby="lok-vise">
        <h2 id="lok-vise" class="lok__vise-h">Pogledajte i</h2>
        <ul role="list">
          <li><a class="link-arrow" href={url('/vaktija')}>Vaktija — namaska vremena</a></li>
          <li><a class="link-arrow" href={url('/kontakt')}>Kontakt i poruka džematu</a></li>
          <li><a class="link-arrow" href={url('/o-dzamiji')}>Historija džamije</a></li>
          <li><a class="link-arrow" href={url('/galerija')}>Galerija</a></li>
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .lok { display: grid; gap: var(--space-5); align-items: stretch; }
  @media (min-width: 960px) {
    .lok { grid-template-columns: minmax(0, 1fr) 380px; gap: var(--space-6); }
    .lok__map { grid-column: 1; grid-row: 1; }
    .lok__info { grid-column: 2; grid-row: 1; }
  }
  .lok__info { gap: var(--space-3); padding: var(--space-5); align-self: start; }
  .lok__info > * { margin: 0; }
  .lok__pin {
    display: grid; place-items: center; width: 52px; height: 52px;
    border-radius: 16px; background: var(--color-accent-soft); color: var(--color-accent);
  }
  .lok__h { font-size: clamp(1.3rem, 1vw + 1rem, 1.6rem); }
  .lok__adresa { font-size: 1.2rem; font-weight: 700; line-height: 1.4; }
  .lok__small { font-size: 0.86rem; }
  .lok__btns { display: grid; gap: var(--space-3); margin-top: var(--space-2) !important; }
  .lok__btn { min-height: 52px; font-size: 1.02rem; white-space: normal; text-align: center; }
  .lok__koord {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-3);
    padding-top: var(--space-3) !important; border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }
  .lok__label { font-weight: 700; color: var(--color-text-muted); margin-right: 0.3em; }
  .lok__mono { font-variant-numeric: tabular-nums; }
  .lok__map {
    min-height: clamp(340px, 62vh, 600px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    background: var(--color-surface-2);
  }
  .lok__map iframe { width: 100%; height: 100%; min-height: inherit; border: 0; display: block; }

  .lok-dno { display: grid; gap: var(--space-6); }
  .lok__foto { margin: 0; }
  .lok__foto img {
    width: 100%; height: auto; aspect-ratio: 16 / 7; object-fit: cover;
    border-radius: var(--radius-lg); border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm); background: var(--color-surface-2);
  }
  @media (max-width: 600px) { .lok__foto img { aspect-ratio: 4 / 3; } }
  .lok__foto figcaption { margin-top: var(--space-2); font-size: 0.8rem; color: var(--color-text-muted); }
  .lok__vise-h {
    font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-accent); margin: 0 0 var(--space-2);
  }
  .lok__vise ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-5); }
</style>
