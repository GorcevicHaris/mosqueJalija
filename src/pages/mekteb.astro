---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Icon, { icons, type IconName } from '../components/ui/Icon.astro';
import RasporedSedmica from '../components/obrasci/RasporedSedmica.astro';
import { url } from '../lib/url';
import { profilPredavaca } from '../lib/imam';
import { obavjestenja, imami, predavanja, formatDatum, karticeStranica, tekstStranice, tekstoviStranica } from '../lib/data';

// Uvodni tekst iz admina (Tekstovi stranica → mekteb); prazno = ugrađeni tekst ispod.
const tekst = tekstStranice('mekteb');
const naslovStranice = tekstoviStranica['mekteb']?.naslov?.trim() || 'Mekteb i halke';
const vezana = obavjestenja.filter((o) => /mekteb|halk/i.test(o.kategorija)).slice(0, 4);
// samo ako podaci izričito kažu "imam džamije" (npr. "Glavni imam Medžlisa" se ne računa)
const imamDzamije = imami.filter((i) => i.potvrdjeno && i.uloga && /imam (ove )?džamije|imam džamije na jaliji/i.test(i.uloga));
const halkeSnimci = predavanja.filter((p) => p.kategorija === 'halka-hadisa').length;

// "Šta djeca uče" iz admina (Kartice na stranicama → mekteb); bez kartica u bazi = ugrađena lista.
const uci = karticeStranica('mekteb').map((k) => ({
  naslov: k.naslov,
  opis: k.tekst,
  ikona: (k.ikona && k.ikona in icons ? k.ikona : 'star8') as IconName,
}));
---
<BaseLayout title={naslovStranice} description="Mekteb za djecu i halke za odrasle u Džamiji na Jaliji — šta se uči, raspored i prijava.">
  <PageHero eyebrow="Znanje i odgoj" title={naslovStranice} subtitle="Vjerska pouka za djecu i halke za odrasle." />

  <div class="section">
    <div class="container container--narrow flow">
      <section class="flow__sec" aria-labelledby="mekteb-naslov">
        <h2 id="mekteb-naslov" class="flow__h">Mekteb za djecu</h2>
        {tekst ? (
          tekst.paragrafi.map((par) => <p>{par}</p>)
        ) : (
          <p>
            U mektebu djeca uče čitati Kur'an i upoznaju osnove vjerovanja i ibadeta. Nastava se prilagođava
            uzrastu, a roditelji su dobrodošli da prate napredak.
          </p>
        )}

        <h3 class="flow__h3">Šta djeca uče</h3>
        <ul class="flow-list mk-uci" role="list">
          {uci.map((u) => (
            <li>
              <span class="flow-list__icon"><Icon name={u.ikona} /></span>
              <span class="flow-list__body">
                <span class="flow-list__t">{u.naslov}</span>
                <span class="flow-list__d">{u.opis}</span>
              </span>
            </li>
          ))}
        </ul>

        <div class="flow__cta">
          <a class="btn btn--primary" href={url('/upis?program=mekteb')}>
            <Icon name="graduation" size={18} /> Prijavi dijete u mekteb
          </a>
          {imamDzamije.length > 0 && (
            <span class="mk-imam">
              Imam: {imamDzamije.map((i, n) => <>{n > 0 && ', '}{profilPredavaca(i.slug) ? <a href={url(profilPredavaca(i.slug)!)}>{i.punoIme}</a> : i.punoIme}</>)}
            </span>
          )}
        </div>
      </section>

      <section class="flow__sec">
        <RasporedSedmica naslovId="raspored-mekteb" nivo={2} naslovKlasa="flow__h" />
      </section>

      <section class="flow__sec" aria-labelledby="halke-naslov">
        <h2 id="halke-naslov" class="flow__h">Halke za odrasle</h2>
        <p>
          Halka je zajedničko učenje u džamiji — hadis, tefsir i druge teme, uz pitanja i razgovor sa imamom.
          Termini su u <a href={url('/raspored')}>sedmičnom rasporedu</a>.
        </p>
        {halkeSnimci > 0 && (
          <p class="flow__lead">
            Snimke halki pogledajte među <a href={url('/predavanja?kategorija=halka-hadisa')}>predavanjima</a> ({halkeSnimci}).
          </p>
        )}
        <div class="flow__cta">
          <a class="btn btn--ghost" href={url('/upis')}>Prijava za halke i kurseve</a>
        </div>
      </section>

      <section class="flow__sec" aria-labelledby="najave-naslov">
        <h2 id="najave-naslov" class="flow__h">Najave</h2>
        {vezana.length ? (
          <ul class="link-list" role="list">
            {vezana.map((o) => (
              <li>
                <a href={url(`/obavjestenja/${o.slug}`)}>{o.naslov}</a>
                <span class="link-list__meta">
                  <time datetime={o.datum}>{formatDatum(o.datum)}</time>
                  {o.placeholder && <> · <span class="badge badge--warn">Primjer sadržaja</span></>}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">Trenutno nema najava. Pratite <a href={url('/obavjestenja')}>obavještenja</a>.</p>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .mk-uci { gap: var(--space-3); }
  .mk-imam { font-size: 0.92rem; color: var(--color-text-muted); }
</style>
