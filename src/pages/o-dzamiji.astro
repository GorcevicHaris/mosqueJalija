---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import SourceLink from '../components/ui/SourceLink.astro';
import Icon from '../components/ui/Icon.astro';
import { url } from '../lib/url';
import { dzamija, punaAdresa } from '../lib/data';
import { naslovnaSlika } from '../lib/slike';

const d = dzamija;
const foto = naslovnaSlika();
const opis = 'Vakuf, gradnja, otvaranje i džemat danas — činjenice uz navedene izvore.';
---
<BaseLayout title="O džamiji — historija" description={`O Džamiji na Jaliji: historija, činjenice i lokacija. ${d.kratakOpis ?? ''}`.trim()} image={d.naslovnaSlika ?? undefined}>
  <PageHero eyebrow="O džamiji" title="Historija džamije" subtitle={opis} />

  <section class="section">
    <div class="container container--narrow about">
      <div class="about-main">
        <h2 class="visually-hidden">Historija</h2>
        {foto && (
          <figure class="photo">
            <img
              src={foto.src}
              srcset={foto.srcset}
              sizes={foto.srcset ? '(min-width: 800px) 760px, 100vw' : undefined}
              alt={`${d.naziv} — fotografija džamije sa munarom`}
              width="2000"
              height="1100"
              fetchpriority="high"
              decoding="async"
            />
            {foto.izvor && <figcaption class="photo__credit">{foto.izvor}</figcaption>}
          </figure>
        )}
        {d.kratakOpis && <p class="lead">{d.kratakOpis}</p>}
        {d.historija.length ? (
          <ol class="timeline" role="list">
            {d.historija.map((h) => (
              <li class="timeline__item">
                <span class="timeline__dot" aria-hidden="true"></span>
                <h3 class="timeline__title">{h.naslov}</h3>
                <div class="timeline__body">
                  {h.tekst.split(/\n{2,}/).map((p) => <p>{p}</p>)}
                </div>
                <SourceLink izvor={h.izvor} required />
              </li>
            ))}
          </ol>
        ) : (
          <div class="stack">
            <Placeholder label="historija džamije" hint="godina izgradnje, graditelj (vakif), obnove i važni događaji — svaka tvrdnja sa izvorom" />
            <p class="muted">
              Ne objavljujemo nepotvrđene podatke o historiji džamije. Ako imate pouzdane izvore (knjige, arhivske
              dokumente, publikacije Islamske zajednice), molimo vas da nas <a href={url('/kontakt')}>kontaktirate</a>.
            </p>
          </div>
        )}

      </div>

      <section class="about-sec" aria-labelledby="cinjenice-naslov">
        <h2 id="cinjenice-naslov" class="flow__h">Činjenice</h2>
        {d.cinjenice.length ? (
          <dl class="facts">
            {d.cinjenice.map((c) => (
              <div class="fact">
                <dt>{c.oznaka}</dt>
                <dd>
                  <span class="fact__value">{c.vrijednost}</span>
                  <SourceLink izvor={c.izvor} />
                </dd>
              </div>
            ))}
          </dl>
        ) : (
          <Placeholder label="osnovne činjenice" hint="npr. godina izgradnje, površina, kapacitet" />
        )}
      </section>

      <section class="about-sec" aria-labelledby="lokacija-naslov">
        <h2 id="lokacija-naslov" class="flow__h">Lokacija</h2>
        <p class="loc">
          {punaAdresa() || <Placeholder inline label="adresa" />}
        </p>
        {!d.koordinate.potvrdjeno && <p class="muted small">Položaj na mapi je približan i čeka potvrdu džemata.</p>}
        <a class="btn btn--primary" href={url('/kontakt')}><Icon name="map-pin" size={18} /> Mapa i kontakt</a>
      </section>

      {d.izvori.length > 0 && (
        <section class="about-sec" aria-labelledby="izvori-naslov">
          <h2 id="izvori-naslov" class="flow__h">Izvori</h2>
          <ul class="sources" role="list">
            {d.izvori.map((i) => (
              <li>{i.url ? <a href={i.url} target="_blank" rel="noopener">{i.naziv}</a> : i.naziv}</li>
            ))}
          </ul>
        </section>
      )}

      <nav class="about-sec related" aria-label="Povezane stranice">
        <p class="related__label">Pogledajte i</p>
        <ul role="list">
          <li><a class="link-arrow" href={url('/galerija')}>Galerija</a></li>
          <li><a class="link-arrow" href={url('/pravila-ponasanja')}>Pravila ponašanja</a></li>
          <li><a class="link-arrow" href={url('/imami')}>Imami i predavači</a></li>
          <li><a class="link-arrow" href={url('/mekteb')}>Mekteb i halke</a></li>
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .photo { margin: 0 0 var(--space-6); }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 20 / 11;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    background: var(--color-surface-2);
  }
  .photo__credit { margin-top: var(--space-2); font-size: 0.8rem; color: var(--color-text-muted); }
  .about-main > .lead { margin-bottom: var(--space-7); max-width: var(--measure); }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 var(--space-6); position: relative; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 9px; top: 8px; bottom: 8px;
    width: 2px;
    background: linear-gradient(var(--color-accent-bright), var(--color-border));
  }
  .timeline__item { position: relative; padding-bottom: var(--space-6); }
  .timeline__item:last-child { padding-bottom: 0; }
  .timeline__dot {
    position: absolute;
    left: calc(-1 * var(--space-6));
    top: 0.15em;
    width: 20px; height: 20px;
    background: var(--color-accent-bright);
    -webkit-mask: var(--ornament-star) center / contain no-repeat;
    mask: var(--ornament-star) center / contain no-repeat;
  }
  .timeline__title { font-size: 1.15rem; font-weight: 600; line-height: 1.3; }
  .timeline__body p { max-width: var(--measure); }
  .timeline__body p:last-child { margin-bottom: 0; }

  .about-sec { margin-top: var(--space-7); padding-top: var(--space-7); border-top: 1px solid var(--color-border); }
  .facts { margin: 0; display: grid; border-top: 1px solid var(--color-border); }
  .fact {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-1) var(--space-4);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  @media (max-width: 560px) { .fact { grid-template-columns: 1fr; } }
  .fact dt { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent); }
  .fact dd { margin: 0; }
  .fact__value { font-weight: 600; line-height: 1.4; }
  .fact :global(.source) { margin-top: 2px; font-size: 0.8rem; }
  .loc { margin: 0 0 var(--space-3); font-size: 1.08rem; font-weight: 600; }
  .small { font-size: 0.88rem; margin: 0 0 var(--space-4); }
  .sources { padding-left: 1.2em; margin: 0; display: grid; gap: var(--space-2); }
  .related { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); }
  .related__label { margin: 0; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent); }
  .related ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-5); }
</style>
