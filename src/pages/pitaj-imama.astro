---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import PitanjeForma from '../components/obrasci/PitanjeForma.astro';
import { imaSupabase, procitajZaBuild } from '../lib/obrasci/supabase-rest';
import { UPIT_PITANJA, renderPitanja, type JavnoPitanje } from '../lib/obrasci/pitanja';
import { url } from '../lib/url';

// Build: objavljeni odgovori ulaze u HTML (SEO). Preglednik ih zatim osvježi iz baze.
const { redovi } = imaSupabase ? await procitajZaBuild<JavnoPitanje>('pitanja_javna', UPIT_PITANJA) : { redovi: [] as JavnoPitanje[] };
const kategorije = [...new Set(redovi.map((p) => p.kategorija).filter((k): k is string => Boolean(k)))].sort((a, b) => a.localeCompare(b, 'sr'));
const faq = redovi.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: redovi.slice(0, 50).map((p) => ({
        '@type': 'Question',
        name: p.pitanje.trim(),
        acceptedAnswer: { '@type': 'Answer', text: p.odgovor.trim() },
      })),
    }
  : null;
---
<BaseLayout
  title="Pitaj imama"
  description="Postavite pitanje imamu Džamije na Jaliji (i anonimno) i pročitajte objavljene odgovore na pitanja džemata."
>
  {faq && <script is:inline type="application/ld+json" set:html={JSON.stringify(faq).replace(/</g, '\\u003c')} />}
  <PageHero eyebrow="Pitanja i odgovori" title="Pitaj imama" subtitle="Imate pitanje o vjeri, ibadetu ili životu džemata? Pitajte — i anonimno." />

  <section class="section section--tight">
    <div class="container pq">
      <div class="pq__forma">
        <div class="card pq__card">
          <h2 class="pq__h">Postavite pitanje</h2>
          <div class="pq__napomena" role="note">
            <Icon name="info" size={20} />
            <div>
              <p><strong>Odgovori se objavljuju nakon što ih imam pregleda</strong> — zato odgovor može potrajati nekoliko dana. Ne objavljujemo sva pitanja.</p>
              <p>Za hitna ili lična pitanja (dženaza, vjenčanje, porodične situacije) obratite se džematu direktno — preko <a href={url('/kontakt')}>kontakt stranice</a> ili lično u džamiji.</p>
            </div>
          </div>
          <PitanjeForma id="pitanje" />
        </div>
      </div>

      <div class="pq__odgovori">
        <h2 class="pq__h" id="odgovori-naslov">Objavljeni odgovori</h2>

        <div class="pq__alati" data-pq-alati hidden={redovi.length === 0}>
          <div class="field">
            <label for="pq-trazi">Pretraži pitanja i odgovore</label>
            <input class="input" id="pq-trazi" type="search" placeholder="npr. namaz, zekat, abdest" autocomplete="off" data-pq-trazi />
          </div>
          <ul class="chips" role="list" aria-label="Kategorija" data-pq-kategorije hidden={kategorije.length < 2}>
            <li><button type="button" class="chip" aria-pressed="true" data-value="">Sve</button></li>
            {kategorije.map((k) => <li><button type="button" class="chip" aria-pressed="false" data-value={k}>{k}</button></li>)}
          </ul>
          <p class="muted pq__broj" aria-live="polite" data-pq-broj></p>
        </div>

        <ul class="pq__lista" role="list" aria-labelledby="odgovori-naslov" data-pq-lista><Fragment set:html={renderPitanja(redovi)} /></ul>

        <div class="pq__prazno" data-pq-prazno hidden={redovi.length > 0}>
          <Icon name="message" size={28} />
          <p><strong>Još nema objavljenih odgovora.</strong></p>
          <p class="muted">Budite prvi koji će postaviti pitanje — odgovori će se pojaviti ovdje.</p>
        </div>
        <p class="muted pq__nema-rez" data-pq-nema-rez hidden>Nijedno pitanje ne odgovara pretrazi.</p>
        <p class="muted pq__greska" data-pq-greska hidden></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pq { display: grid; gap: var(--space-6); }
  @media (min-width: 1000px) { .pq { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: start; } }
  .pq__h { margin: 0 0 var(--space-3); font-size: clamp(1.4rem, 1.5vw + 1rem, 1.8rem); }
  .pq__card { padding: clamp(var(--space-4), 3vw, var(--space-6)); gap: var(--space-4); }
  .pq__card .pq__h { margin: 0; }
  .pq__napomena {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    font-size: 0.92rem;
  }
  .pq__napomena :global(svg) { color: var(--color-accent); margin-top: 2px; }
  .pq__napomena p { margin: 0; }
  .pq__napomena p + p { margin-top: var(--space-2); }
  .pq__alati { display: grid; gap: var(--space-3); margin-bottom: var(--space-4); }
  .pq__alati[hidden], [data-pq-kategorije][hidden], .pq__prazno[hidden], .pq__nema-rez[hidden], .pq__greska[hidden] { display: none; }
  .pq__broj { margin: 0; font-size: 0.88rem; }
  .pq__broj:empty { display: none; }
  .pq__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .pq__prazno {
    display: grid; justify-items: center; text-align: center; gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    border: 2px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
  }
  .pq__prazno p { margin: 0; }
  .pq__prazno strong { color: var(--color-text); }
  .pq__nema-rez, .pq__greska { margin: var(--space-3) 0 0; }

  .pq__lista :global(.pi-stavka) { padding: 0; }
  .pq__lista :global(.pi-stavka[hidden]) { display: none; }
  .pq__lista :global(.pi-pitanje) {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start;
    padding: var(--space-4);
    cursor: pointer; list-style: none;
    font-weight: 700; line-height: 1.45;
    min-height: 48px;
  }
  .pq__lista :global(.pi-pitanje::-webkit-details-marker) { display: none; }
  .pq__lista :global(.pi-pitanje:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: -3px; border-radius: var(--radius-lg); }
  .pq__lista :global(.pi-oznaka) {
    display: inline-grid; place-items: center;
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--color-accent-soft); color: var(--color-accent);
    font-size: 0.85rem; font-weight: 800;
  }
  .pq__lista :global(.pi-oznaka--o) { background: color-mix(in srgb, var(--color-primary) 14%, transparent); color: var(--color-primary); }
  .pq__lista :global(.pi-det[open] .pi-pitanje) { border-bottom: 1px solid var(--color-border); }
  .pq__lista :global(.pi-odgovor) { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); padding: var(--space-4); }
  .pq__lista :global(.pi-odgovor__tekst) { display: grid; gap: var(--space-3); min-width: 0; overflow-wrap: anywhere; }
  .pq__lista :global(.pi-odgovor__tekst p) { margin: 0; }
  .pq__lista :global(.pi-meta) { font-size: 0.85rem; color: var(--color-text-muted); }
  .pq__lista :global(.badge) { justify-self: start; }
</style>

<script>
  import { procitaj } from '../lib/obrasci/supabase-rest';
  import { UPIT_PITANJA, renderPitanja, type JavnoPitanje } from '../lib/obrasci/pitanja';
  import { normalizuj } from '../lib/extras/normalizuj';

  const lista = document.querySelector<HTMLElement>('[data-pq-lista]')!;
  const alati = document.querySelector<HTMLElement>('[data-pq-alati]')!;
  const trazi = document.querySelector<HTMLInputElement>('[data-pq-trazi]')!;
  const katWrap = document.querySelector<HTMLElement>('[data-pq-kategorije]')!;
  const broj = document.querySelector<HTMLElement>('[data-pq-broj]')!;
  const prazno = document.querySelector<HTMLElement>('[data-pq-prazno]')!;
  const nemaRez = document.querySelector<HTMLElement>('[data-pq-nema-rez]')!;
  const greska = document.querySelector<HTMLElement>('[data-pq-greska]')!;
  let kategorija = '';

  function filtriraj() {
    const q = normalizuj(trazi.value.trim());
    const rijeci = q.split(/\s+/).filter(Boolean);
    let vidljivo = 0;
    const stavke = lista.querySelectorAll<HTMLElement>('.pi-stavka');
    stavke.forEach((li) => {
      const tekst = normalizuj(li.textContent ?? '');
      const ok = rijeci.every((r) => tekst.includes(r)) && (!kategorija || li.dataset.kategorija === kategorija);
      li.hidden = !ok;
      if (ok) vidljivo++;
      // pri pretrazi otvori pogotke da se vidi odgovor
      const det = li.querySelector('details');
      if (det && rijeci.length) det.open = ok;
    });
    nemaRez.hidden = !(stavke.length && vidljivo === 0);
    broj.textContent = stavke.length ? (rijeci.length || kategorija ? `Prikazano ${vidljivo} od ${stavke.length}` : `${stavke.length} odgovora`) : '';
  }

  function postaviKategorije(redovi: JavnoPitanje[]) {
    const kat = [...new Set(redovi.map((p) => p.kategorija).filter((k): k is string => Boolean(k)))].sort((a, b) => a.localeCompare(b, 'sr'));
    katWrap.hidden = kat.length < 2;
    katWrap.innerHTML = '';
    for (const k of ['', ...kat]) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'chip';
      b.dataset.value = k;
      b.textContent = k || 'Sve';
      b.setAttribute('aria-pressed', String(k === kategorija));
      li.append(b);
      katWrap.append(li);
    }
  }

  katWrap.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-value]');
    if (!b) return;
    kategorija = b.dataset.value ?? '';
    katWrap.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    filtriraj();
  });
  trazi.addEventListener('input', filtriraj);

  async function osvjezi() {
    const r = await procitaj<JavnoPitanje>('pitanja_javna', UPIT_PITANJA);
    if (!r.ok) {
      // konfiguracija = sajt bez Supabase-a; ostale greške: zadržavamo verziju iz builda
      // nema-tabele = baza još nije postavljena → ostaje prazno stanje
      if (r.vrsta !== 'konfiguracija' && r.vrsta !== 'nema-tabele' && !lista.children.length) {
        greska.hidden = false;
        greska.textContent =
          r.vrsta === 'mreza'
            ? 'Najnovije odgovore trenutno nije moguće učitati — provjerite internet vezu i osvježite stranicu.'
            : 'Najnovije odgovore trenutno nije moguće učitati. Pokušajte ponovo malo kasnije.';
      }
      return;
    }
    const otvoreni = new Set([...lista.querySelectorAll<HTMLElement>('.pi-stavka')].filter((li) => li.querySelector('details')?.open).map((li) => li.dataset.pitanjeId));
    lista.innerHTML = renderPitanja(r.podaci);
    lista.querySelectorAll<HTMLElement>('.pi-stavka').forEach((li) => {
      if (otvoreni.has(li.dataset.pitanjeId)) li.querySelector('details')!.open = true;
    });
    prazno.hidden = r.podaci.length > 0;
    alati.hidden = r.podaci.length === 0;
    greska.hidden = true;
    postaviKategorije(r.podaci);
    filtriraj();
  }

  filtriraj();
  void osvjezi();
</script>
