---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LectureCard from '../../components/predavanja/LectureCard.astro';
import YouTubeFacade from '../../components/predavanja/YouTubeFacade.astro';
import ShareButton from '../../components/predavanja/ShareButton.astro';
import ImamAvatar from '../../components/predavanja/ImamAvatar.astro';
import Transkript from '../../components/predavanja/Transkript.astro';
import { predavanja, getImam, getKategorija, getSerija, formatDatum } from '../../lib/data';
import { dijeloviSerije, filterQuery, opisHTML, srodnaPredavanja } from '../../lib/predavanja';
import { brojTekst, oblik, trajanjeISO, trajanjeTekst } from '../../lib/format';
import { url } from '../../lib/url';
import type { Predavanje } from '../../lib/types';

export function getStaticPaths() {
  return predavanja.map((p) => ({ params: { id: p.id }, props: { p } }));
}

interface Props { p: Predavanje }
const { p } = Astro.props;

const imam = getImam(p.imam);
const kategorija = getKategorija(p.kategorija);
const serija = getSerija(p.serija);
const dijelovi = dijeloviSerije(p.serija);
const idx = dijelovi.findIndex((x) => x.id === p.id);
const prethodni = idx > 0 ? dijelovi[idx - 1] : null;
const sljedeci = idx >= 0 && idx < dijelovi.length - 1 ? dijelovi[idx + 1] : null;
const srodna = srodnaPredavanja(p, 6);

const naslov = p.naslovCist || p.naslov;
const dioTekst = serija && p.serijaDio ? `${serija.naziv}, dio ${p.serijaDio}` : null;
const punNaslov = dioTekst && !naslov.includes(String(p.serijaDio)) ? `${naslov} (dio ${p.serijaDio})` : naslov;
const traj = trajanjeTekst(p.trajanje);
const ytUrl = `https://www.youtube.com/watch?v=${encodeURIComponent(p.id)}`;
// jedinstven opis za svaku stranicu: naslov + kategorija/predavač/datum + početak opisa sa YouTube-a
const opisMetaPun = [
  `${punNaslov} — ${kategorija?.naziv ?? 'Predavanje'}${imam ? `, ${imam.punoIme}` : ''}, ${formatDatum(p.datum)}`,
  p.opis?.replace(/\s+/g, ' ').trim() || 'Snimak sa YouTube kanala Džamije na Jaliji.',
].join(' ');
const opisMeta =
  opisMetaPun.length <= 160 ? opisMetaPun : `${opisMetaPun.slice(0, 157).replace(/\s+\S*$/, '')}…`;
const site = Astro.site ?? new URL('https://gorcevicharis.github.io');
const pageUrl = new URL(url(`/predavanja/${p.id}`), site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: punNaslov,
  description: p.opis?.trim() || opisMeta,
  thumbnailUrl: [p.thumbnail, `https://i.ytimg.com/vi/${p.id}/hqdefault.jpg`].filter((v, i, a) => a.indexOf(v) === i),
  uploadDate: `${p.datum}T12:00:00+01:00`,
  ...(p.trajanje > 0 && { duration: trajanjeISO(p.trajanje) }),
  embedUrl: `https://www.youtube-nocookie.com/embed/${p.id}`,
  url: pageUrl,
  inLanguage: 'bs',
  ...(typeof p.pregledi === 'number' && {
    interactionStatistic: {
      '@type': 'InteractionCounter',
      interactionType: { '@type': 'WatchAction' },
      userInteractionCount: p.pregledi,
    },
  }),
  ...(imam && { author: { '@type': 'Person', name: imam.punoIme } }),
  publisher: { '@type': 'Organization', name: 'Džamija na Jaliji', url: new URL(url('/'), site).href },
};
const ld = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<BaseLayout title={punNaslov} description={opisMeta} image={p.thumbnail}>
  <article class="pd">
    <div class="container pd__top">
      <nav class="pd__crumbs" aria-label="Putanja">
        <ol>
          <li><a href={url('/predavanja')}>Predavanja</a></li>
          {p.kategorija === 'hutba' && <li><a href={url('/hutbe')}>Hutbe</a></li>}
          {serija && <li><a href={url(`/predavanja${filterQuery({ serija: serija.slug, sort: 'dio' })}`)}>{serija.naziv}</a></li>}
          <li aria-current="page"><span>{dioTekst ? `Dio ${p.serijaDio}` : naslov}</span></li>
        </ol>
      </nav>

      <div class="pd__grid">
        <div class="pd__main">
          <YouTubeFacade id={p.id} naslov={punNaslov} thumbnail={p.thumbnail} />

          <header class="pd__head">
            <div class="pd__badges">
              {kategorija && (
                <a class="badge pd__badge" href={url(`/predavanja${filterQuery({ kategorija: kategorija.slug })}`)}>{kategorija.naziv}</a>
              )}
              {serija && (
                <a class="badge badge--primary pd__badge" href={url(`/predavanja${filterQuery({ serija: serija.slug, sort: 'dio' })}`)}>
                  {serija.naziv}{p.serijaDio ? ` · dio ${p.serijaDio}` : ''}
                </a>
              )}
            </div>
            <h1 class="pd__title">{punNaslov}</h1>
            <dl class="pd__meta">
              <div>
                <dt>Datum</dt>
                <dd><time datetime={p.datum}>{formatDatum(p.datum)}</time></dd>
              </div>
              {traj && (
                <div>
                  <dt>Trajanje</dt>
                  <dd>{traj}</dd>
                </div>
              )}
              <div>
                <dt>Predavač</dt>
                <dd>
                  {imam ? (
                    <a class="pd__imam" href={url(`/imami/${imam.slug}`)}>
                      <ImamAvatar punoIme={imam.punoIme} slika={imam.slika} size={32} dekorativno />
                      <span>{imam.punoIme}</span>
                    </a>
                  ) : (
                    <span class="muted">Nije naveden</span>
                  )}
                  {imam && !p.imamPotvrdjen && (
                    <span class="badge badge--warn pd__nepotvrdjeno" title="Predavač je određen automatski (npr. po seriji) i čeka provjeru.">nepotvrđeno</span>
                  )}
                </dd>
              </div>
              {typeof p.pregledi === 'number' && (
                <div>
                  <dt>Pregledi</dt>
                  <dd>{brojTekst(p.pregledi)}</dd>
                </div>
              )}
            </dl>
            <div class="pd__actions">
              <a class="btn btn--primary" href={ytUrl} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24 24 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.6 49.6 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24 24 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.6 49.6 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path><path d="m10 15 5-3-5-3z"></path></svg>
                Pogledaj na YouTube-u
              </a>
              <ShareButton naslov={punNaslov} link={pageUrl} />
            </div>
          </header>

          {p.opis && p.opis.trim() && (
            <section class="pd__opis" aria-labelledby="opis-naslov">
              <h2 id="opis-naslov" class="pd__h2">Opis</h2>
              <div class="prose" set:html={opisHTML(p.opis)} />
            </section>
          )}

          <Transkript id={p.id} naslov={punNaslov} />

          {serija && (prethodni || sljedeci) && (
            <nav class="pd__serija-nav" aria-label={`Navigacija kroz seriju ${serija.naziv}`}>
              {prethodni ? (
                <a class="pd__sn pd__sn--prev" href={url(`/predavanja/${prethodni.id}`)} rel="prev">
                  <span class="pd__sn-lbl">← Prethodni dio{prethodni.serijaDio ? ` (${prethodni.serijaDio})` : ''}</span>
                  <span class="pd__sn-t">{prethodni.naslovCist}</span>
                </a>
              ) : <span />}
              {sljedeci && (
                <a class="pd__sn pd__sn--next" href={url(`/predavanja/${sljedeci.id}`)} rel="next">
                  <span class="pd__sn-lbl">Sljedeći dio{sljedeci.serijaDio ? ` (${sljedeci.serijaDio})` : ''} →</span>
                  <span class="pd__sn-t">{sljedeci.naslovCist}</span>
                </a>
              )}
            </nav>
          )}
        </div>

        {serija && dijelovi.length > 1 && (
          <aside class="pd__aside" aria-labelledby="serija-naslov">
            <div class="pd__serija card">
              <p class="eyebrow">Serija · {dijelovi.length} {oblik(dijelovi.length, 'dio', 'dijela', 'dijelova')}</p>
              <h2 id="serija-naslov" class="pd__serija-title">{serija.naziv}</h2>
              {serija.opis && <p class="pd__serija-opis muted">{serija.opis}</p>}
              <ol class="pd__dijelovi">
                {dijelovi.map((d, i) => (
                  <li>
                    <a
                      href={url(`/predavanja/${d.id}`)}
                      aria-current={d.id === p.id ? 'page' : undefined}
                      class:list={['pd__dio', { 'is-current': d.id === p.id }]}
                    >
                      <span class="pd__dio-n">{d.serijaDio ?? i + 1}</span>
                      <span class="pd__dio-t">{d.naslovCist}</span>
                      {trajanjeTekst(d.trajanje) && <span class="pd__dio-d">{trajanjeTekst(d.trajanje)}</span>}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        )}
      </div>
    </div>

    {srodna.length > 0 && (
      <section class="section section--tint pd__srodna" aria-labelledby="srodna-naslov">
        <div class="container">
          <div class="pd__srodna-head">
            <h2 id="srodna-naslov">Srodna predavanja</h2>
            <a class="link-arrow" href={url(`/predavanja${filterQuery(imam ? { imam: imam.slug } : { kategorija: p.kategorija })}`)}>
              {imam ? `Sva predavanja: ${imam.punoIme}` : 'Sva predavanja'}
            </a>
          </div>
          <div class="grid-cards">
            {srodna.map((s) => <LectureCard predavanje={s} />)}
          </div>
        </div>
      </section>
    )}
  </article>
  <script type="application/ld+json" set:html={ld} />
</BaseLayout>

<style>
  .pd__top { padding-block: var(--space-5) var(--space-7); }
  .pd__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .pd__crumbs li + li::before { content: '/'; margin-right: var(--space-2); opacity: 0.6; }
  .pd__crumbs li[aria-current] { display: flex; min-width: 0; max-width: 100%; }
  .pd__crumbs li[aria-current] span {
    display: inline-block;
    min-width: 0;
    max-width: 40ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
  }
  .pd__grid { display: grid; gap: var(--space-6); }
  .pd__grid:not(:has(.pd__aside)) { max-width: 980px; }
  @media (min-width: 1024px) {
    .pd__grid:has(.pd__aside) { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; }
    .pd__aside { position: sticky; top: calc(var(--header-h, 72px) + var(--space-4)); }
  }
  .pd__main { min-width: 0; }
  .pd__head { margin-top: var(--space-5); }
  .pd__badges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3); }
  .pd__badge { text-decoration: none; }
  .pd__badge:hover { text-decoration: underline; }
  .pd__title {
    font-size: clamp(1.6rem, 2.4vw + 1rem, 2.4rem);
    line-height: 1.2;
    margin: 0 0 var(--space-4);
    overflow-wrap: anywhere;
  }
  .pd__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0 0 var(--space-5);
  }
  .pd__meta dt {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: 700;
  }
  .pd__meta dd { margin: 0.15rem 0 0; font-weight: 600; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .pd__meta dd a { display: inline-flex; align-items: center; min-height: 40px; }
  .pd__imam { gap: var(--space-2); }
  .pd__imam :global(.avatar) { box-shadow: 0 0 0 2px var(--color-accent-bright); }
  .pd__nepotvrdjeno { cursor: help; }
  .pd__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .pd__h2 { font-size: 1.3rem; margin: var(--space-7) 0 var(--space-3); }
  .pd__opis :global(.prose) { overflow-wrap: anywhere; }
  .pd__serija-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  .pd__sn {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .pd__sn:hover { border-color: var(--color-primary); box-shadow: var(--shadow-sm); }
  .pd__sn--next { text-align: right; grid-column: 2; }
  .pd__sn-lbl { font-size: 0.82rem; font-weight: 700; color: var(--color-primary); }
  .pd__sn-t { font-weight: 600; overflow-wrap: anywhere; }
  @media (max-width: 560px) {
    .pd__serija-nav { grid-template-columns: 1fr; }
    .pd__sn--next { grid-column: auto; }
  }
  .pd__serija { padding: var(--space-5); }
  .pd__serija-title { font-size: 1.3rem; margin: 0 0 var(--space-2); }
  .pd__serija-opis { font-size: 0.9rem; margin: 0 0 var(--space-4); }
  .pd__dijelovi {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: min(60vh, 520px);
    overflow-y: auto;
    display: grid;
    gap: 2px;
  }
  .pd__dio {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    gap: var(--space-2);
    align-items: baseline;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.92rem;
  }
  .pd__dio:hover { background: var(--color-surface-2); }
  .pd__dio.is-current { background: var(--color-primary); color: var(--color-on-primary); }
  .pd__dio-n { font-weight: 800; font-variant-numeric: tabular-nums; opacity: 0.8; }
  .pd__dio-d { font-size: 0.8rem; opacity: 0.75; font-variant-numeric: tabular-nums; }
  .pd__srodna-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .pd__srodna-head h2 { margin: 0; }
</style>
