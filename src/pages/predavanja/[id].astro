---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeFacade from '../../components/predavanja/YouTubeFacade.astro';
import Transkript from '../../components/predavanja/Transkript.astro';
import { predavanja, getImam, getKategorija, getSerija, formatDatum } from '../../lib/data';
import { profilPredavaca } from '../../lib/imam';
import { dijeloviSerije } from '../../lib/predavanja';
import { trajanjeISO, trajanjeTekst } from '../../lib/format';
import { getTranskriptEn } from '../../lib/transkripti';
import { url } from '../../lib/url';
import type { Predavanje } from '../../lib/types';

export function getStaticPaths() {
  return predavanja.map((p) => ({ params: { id: p.id }, props: { p } }));
}

interface Props { p: Predavanje }
const { p } = Astro.props;

const imam = getImam(p.imam);
// Profil postoji samo za imama džamije; ostali predavači su običan tekst.
const imamProfil = profilPredavaca(imam?.slug);
const kategorija = getKategorija(p.kategorija);
const serija = getSerija(p.serija);
const dijelovi = dijeloviSerije(p.serija);
const idx = dijelovi.findIndex((x) => x.id === p.id);
const prethodni = idx > 0 ? dijelovi[idx - 1] : null;
const sljedeci = idx >= 0 && idx < dijelovi.length - 1 ? dijelovi[idx + 1] : null;

const naslov = p.naslovCist || p.naslov;
const dioTekst = serija && p.serijaDio ? `${serija.naziv}, dio ${p.serijaDio}` : null;
const punNaslov = dioTekst && !naslov.includes(String(p.serijaDio)) ? `${naslov} (dio ${p.serijaDio})` : naslov;
const traj = trajanjeTekst(p.trajanje);
// engleski naslov (iz engleskog prevoda transkripta) — mali podnaslov kad je engleski aktivan
const naslovEn = getTranskriptEn(p.id)?.naslov ?? null;
// jedinstven opis za svaku stranicu: naslov + kategorija/predavač/datum + početak opisa sa YouTube-a
const opisMetaPun = [
  `${punNaslov} — ${kategorija?.naziv ?? 'Predavanje'}${imam ? `, ${imam.punoIme}` : ''}, ${formatDatum(p.datum)}`,
  p.opis?.replace(/\s+/g, ' ').trim() || 'Snimak sa YouTube kanala Džamije na Jaliji.',
].join(' ');
const opisMeta =
  opisMetaPun.length <= 160 ? opisMetaPun : `${opisMetaPun.slice(0, 157).replace(/\s+\S*$/, '')}…`;
const site = Astro.site ?? new URL('https://gorcevicharis.github.io');
const pageUrl = new URL(url(`/predavanja/${p.id}`), site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: punNaslov,
  description: p.opis?.trim() || opisMeta,
  thumbnailUrl: [p.thumbnail, `https://i.ytimg.com/vi/${p.id}/hqdefault.jpg`].filter((v, i, a) => a.indexOf(v) === i),
  uploadDate: `${p.datum}T12:00:00+01:00`,
  ...(p.trajanje > 0 && { duration: trajanjeISO(p.trajanje) }),
  embedUrl: `https://www.youtube-nocookie.com/embed/${p.id}`,
  url: pageUrl,
  inLanguage: 'bs',
  ...(typeof p.pregledi === 'number' && {
    interactionStatistic: {
      '@type': 'InteractionCounter',
      interactionType: { '@type': 'WatchAction' },
      userInteractionCount: p.pregledi,
    },
  }),
  ...(imam && { author: { '@type': 'Person', name: imam.punoIme } }),
  publisher: { '@type': 'Organization', name: 'Džamija na Jaliji', url: new URL(url('/'), site).href },
};
const ld = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<BaseLayout title={punNaslov} description={opisMeta} image={p.thumbnail}>
  <article class="pd container">
    <header class="pd__head">
      <a class="pd__back" href={url('/predavanja')}>← Sva predavanja</a>
      <h1 class="pd__title">{punNaslov}</h1>
      {naslovEn && <p class="pd__title-en" lang="en" data-tr-l="en" hidden>{naslovEn}</p>}
      <p class="pd__meta">
        {imam ? (imamProfil ? <a href={url(imamProfil)}>{imam.punoIme}</a> : <span>{imam.punoIme}</span>) : <span>Predavač nije naveden</span>}
        <span aria-hidden="true">·</span>
        <time datetime={p.datum}>{formatDatum(p.datum)}</time>
        {traj && (
          <>
            <span aria-hidden="true">·</span>
            <span>{traj}</span>
          </>
        )}
        {kategorija && (
          <>
            <span aria-hidden="true">·</span>
            <span>{kategorija.naziv}</span>
          </>
        )}
      </p>
    </header>

    <YouTubeFacade id={p.id} naslov={punNaslov} thumbnail={p.thumbnail} />

    <Transkript id={p.id} naslov={punNaslov} />

    {serija && (prethodni || sljedeci) && (
      <nav class="pd__serija" aria-label={`Serija: ${serija.naziv}`}>
        {prethodni && (
          <a href={url(`/predavanja/${prethodni.id}`)} rel="prev" title={prethodni.naslovCist}>
            ← Prethodni dio<span class="visually-hidden">: {prethodni.naslovCist}</span>
          </a>
        )}
        {sljedeci && (
          <a class="pd__next" href={url(`/predavanja/${sljedeci.id}`)} rel="next" title={sljedeci.naslovCist}>
            Sljedeći dio<span class="visually-hidden">: {sljedeci.naslovCist}</span> →
          </a>
        )}
      </nav>
    )}
  </article>
  <script type="application/ld+json" set:html={ld} />
</BaseLayout>

<style>
  .pd {
    max-width: calc(900px + 2 * var(--space-5));
    padding-block: var(--space-4) var(--space-7);
  }
  .pd__head { margin-bottom: var(--space-4); }
  .pd__back {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .pd__back:hover { color: var(--color-primary); text-decoration: underline; }
  .pd__title {
    font-size: clamp(1.4rem, 1.6vw + 1rem, 2rem);
    line-height: 1.25;
    margin: 0 0 var(--space-2);
    overflow-wrap: anywhere;
  }
  .pd__title-en {
    margin: calc(-1 * var(--space-1)) 0 var(--space-2);
    font-size: 1rem;
    font-style: italic;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
  .pd__title-en[hidden] { display: none; }
  .pd__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }
  .pd__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-weight: 600;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
  }
  .pd__meta a:hover { color: var(--color-primary); text-decoration-color: currentColor; }
  .pd__serija {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-4);
    font-size: 0.92rem;
  }
  .pd__serija a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .pd__serija a:hover { color: var(--color-primary); text-decoration: underline; }
  .pd__next { margin-left: auto; }
</style>
