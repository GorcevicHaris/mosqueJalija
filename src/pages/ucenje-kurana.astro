---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import LectureCard from '../components/predavanja/LectureCard.astro';
import Icon from '../components/ui/Icon.astro';
import { url } from '../lib/url';
import UvodStranice from '../components/ui/UvodStranice.astro';
import { karticeStranica, predavanja, tekstoviStranica } from '../lib/data';
const naslovStranice = tekstoviStranica['ucenje-kurana']?.naslov?.trim() || "Učenje Kur'ana";

const snimci = predavanja.filter((p) => p.kategorija === 'ucenje-kurana');

// Koraci i izvori iz admina (Kartice na stranicama); bez kartica u bazi = ugrađene liste (src/lib/kartice.ts).
const koraci = karticeStranica('ucenje-kurana').map((k) => ({ naslov: k.naslov, tekst: k.tekst }));
const izvori = karticeStranica('ucenje-kurana-izvori')
  .filter((k) => k.link)
  .map((k) => ({ naziv: k.naslov, url: k.link!, opis: k.tekst }));
---
<BaseLayout title={naslovStranice} description="Snimci učenja Kur'ana iz Džamije na Jaliji, koraci u učenju i provjereni izvori za čitanje, slušanje i tedžvid.">
  <PageHero eyebrow="Korisno" title={naslovStranice} subtitle="Snimci učenja iz naše džamije, koraci za početnike i provjereni izvori za čitanje i slušanje." arabic="وَرَتِّلِ الْقُرْآنَ تَرْتِيلًا" />

  <div class="section">
    <div class="container container--narrow flow">
      <UvodStranice kljuc="ucenje-kurana" />

      <section class="flow__sec" aria-labelledby="koraci-naslov">
        <h2 id="koraci-naslov" class="flow__h">Kako početi</h2>
        <ol class="flow-list" role="list">
          {koraci.map((k, i) => (
            <li>
              <span class="flow-list__num" aria-hidden="true">{i + 1}</span>
              <span class="flow-list__body">
                <span class="flow-list__t">{k.naslov}</span>
                <span class="flow-list__d">{k.tekst}</span>
              </span>
            </li>
          ))}
        </ol>
        <p class="uk-cta">Najbolje se uči uz učitelja — pogledajte <a href={url('/mekteb')}>mekteb i halke</a>.</p>
      </section>

      <section class="flow__sec" aria-labelledby="snimci-naslov">
        <div class="uk-head flow__wide">
          <h2 id="snimci-naslov" class="flow__h">Snimci iz džamije</h2>
          {snimci.length > 0 && <a class="link-arrow" href={url('/predavanja?kategorija=ucenje-kurana')}>Svi snimci</a>}
        </div>
        {snimci.length ? (
          <div class="grid-cards flow__wide">{snimci.slice(0, 4).map((p) => <LectureCard predavanje={p} />)}</div>
        ) : (
          <Placeholder label="snimci učenja Kur'ana" hint="biće prikazani automatski kada se na kanalu pojave snimci u kategoriji „Učenje Kur'ana“" />
        )}
      </section>

      <section class="flow__sec" aria-labelledby="izvori-naslov">
        <h2 id="izvori-naslov" class="flow__h">Provjereni izvori</h2>
        <ul class="link-list" role="list">
          {izvori.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">
                {s.naziv}<Icon name="external" size={14} class="uk-ext" /><span class="visually-hidden"> (otvara se u novom prozoru)</span>
              </a>
              <span class="link-list__meta">{s.opis}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .uk-cta { margin: var(--space-5) 0 0; color: var(--color-text-muted); }
  .uk-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); margin-bottom: var(--space-4); }
  .uk-head .flow__h { margin: 0; }
  .flow__sec :global(.uk-ext) { margin-left: 0.35em; opacity: 0.7; }
</style>
