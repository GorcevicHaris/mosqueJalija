---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import LectureCard from '../components/predavanja/LectureCard.astro';
import Icon from '../components/ui/Icon.astro';
import { url } from '../lib/url';
import { predavanja } from '../lib/data';

const snimci = predavanja.filter((p) => p.kategorija === 'ucenje-kurana');

const koraci = [
  { naslov: 'Sufara', tekst: 'Arapsko pismo, harfovi i harekati — temelj pravilnog čitanja.' },
  { naslov: 'Učenje iz mushafa', tekst: 'Polagano i pravilno učenje uz učitelja koji ispravlja izgovor.' },
  { naslov: 'Tedžvid', tekst: 'Pravila lijepog učenja: mahredži, medd, gunne i stajanja.' },
  { naslov: 'Hifz i ponavljanje', tekst: 'Učenje kratkih sura napamet i redovno ponavljanje.' },
];

const izvori = [
  { naziv: 'Quran.com', url: 'https://quran.com', opis: "Kur'anski tekst, audio poznatih učača i prevodi značenja, uključujući bosanski prevod Besima Korkuta." },
  { naziv: 'Tanzil', url: 'https://tanzil.net', opis: "Provjeren digitalni tekst Kur'ana sa više prevoda i preciznim prikazom harekata." },
  { naziv: 'QuranicAudio', url: 'https://quranicaudio.com', opis: "Velika zbirka snimaka cijelog Kur'ana u izvedbi poznatih hafiza." },
  { naziv: 'EveryAyah', url: 'https://everyayah.com', opis: 'Učenje ajet po ajet — korisno za ponavljanje i hifz.' },
];
---
<BaseLayout title="Učenje Kur'ana" description="Snimci učenja Kur'ana iz Džamije na Jaliji, koraci u učenju i provjereni izvori za čitanje, slušanje i tedžvid.">
  <PageHero eyebrow="Korisno" title="Učenje Kur'ana" subtitle="Snimci učenja iz naše džamije, koraci za početnike i provjereni izvori za čitanje i slušanje." arabic="وَرَتِّلِ الْقُرْآنَ تَرْتِيلًا" />

  <section class="section" aria-labelledby="snimci-naslov">
    <div class="container">
      <SectionHeading id="snimci-naslov" eyebrow="Iz džamije" title="Snimci učenja Kur'ana" lead="Kiraet imama i hafiza naše džamije.">
        {snimci.length > 0 && <a slot="action" class="link-arrow" href={url('/predavanja')}>Sva predavanja</a>}
      </SectionHeading>
      {snimci.length ? (
        <div class="grid-cards">{snimci.map((p) => <LectureCard predavanje={p} />)}</div>
      ) : (
        <Placeholder label="snimci učenja Kur'ana" hint="biće prikazani automatski kada se na kanalu pojave snimci u kategoriji „Učenje Kur'ana“" />
      )}
    </div>
  </section>

  <section class="section section--tint pattern-bg pattern-bg--fade" aria-labelledby="koraci-naslov">
    <div class="container">
      <SectionHeading id="koraci-naslov" eyebrow="Za početnike" title="Kako početi" align="center" />
      <ol class="steps" role="list">
        {koraci.map((k, i) => (
          <li class="step card">
            <span class="step__num" aria-hidden="true">{i + 1}</span>
            <h3 class="card__title">{k.naslov}</h3>
            <p class="muted">{k.tekst}</p>
          </li>
        ))}
      </ol>
      <p class="steps__cta">
        Najbolje se uči uz učitelja. Pogledajte <a href={url('/mekteb')}>mekteb i halke</a> u našoj džamiji.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="izvori-naslov">
    <div class="container">
      <SectionHeading id="izvori-naslov" eyebrow="Na internetu" title="Provjereni izvori" lead="Vanjski sajtovi otvaraju se u novom prozoru." />
      <ul class="grid-cards" role="list">
        {izvori.map((s) => (
          <li class="card card--link">
            <h3 class="card__title"><a href={s.url} target="_blank" rel="noopener">{s.naziv}<span class="visually-hidden"> (otvara se u novom prozoru)</span></a></h3>
            <p class="muted">{s.opis}</p>
            <span class="ext"><Icon name="external" size={16} /> {new URL(s.url).hostname}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .grid-cards { list-style: none; margin: 0; padding: 0; }
  .grid-cards p { margin: 0 0 var(--space-3); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .step p { margin: 0; }
  .step__num {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: var(--space-3);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.2rem;
    -webkit-mask: var(--ornament-star) center / contain no-repeat;
    mask: var(--ornament-star) center / contain no-repeat;
  }
  .steps__cta { text-align: center; margin: var(--space-6) 0 0; }
  .ext { display: inline-flex; align-items: center; gap: var(--space-1); margin-top: auto; font-size: 0.85rem; font-weight: 700; color: var(--color-primary); }
</style>
