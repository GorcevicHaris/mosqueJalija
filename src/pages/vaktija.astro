---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import VaktijaToday from '../components/vaktija/VaktijaToday.astro';
import VaktijaMonth from '../components/vaktija/VaktijaMonth.astro';
import { dzamija } from '../lib/data';
import { VAKTIJA_CONFIG } from '../lib/vaktija-config';

const grad = dzamija.grad ?? VAKTIJA_CONFIG.tabela.grad;
const izvor = VAKTIJA_CONFIG.zvanicniIzvor;
---
<BaseLayout
  title="Vaktija"
  description={`Vaktija za ${grad}: današnja namaska vremena sa odbrojavanjem do sljedećeg namaza i mjesečna tabela (zora, izlazak sunca, podne, ikindija, akšam, jacija).`}
>
  <PageHero
    eyebrow="Namazi"
    title={`Vaktija · ${grad}`}
    subtitle="Današnja namaska vremena, odbrojavanje do sljedećeg namaza i mjesečni pregled."
    arabic="إِنَّ الصَّلَاةَ كَانَتْ عَلَى الْمُؤْمِنِينَ كِتَابًا مَّوْقُوتًا"
  />

  <section class="section section--tight">
    <div class="container container--narrow vk">
      <div class="vk__today">
        <h2 class="vk__h2">Danas</h2>
        <VaktijaToday />
      </div>

      <h2 class="visually-hidden">Napomene</h2>
      <dl class="vk__info">
        <div>
          <dt>Sabah u džamiji</dt>
          <dd>
            {VAKTIJA_CONFIG.sabahNapomena ? (
              <p>{VAKTIJA_CONFIG.sabahNapomena}</p>
            ) : (
              <Placeholder label="vrijeme klanjanja sabah-namaza u džamiji" hint="džemat treba potvrditi (npr. koliko minuta prije izlaska sunca)" />
            )}
          </dd>
        </div>
        <div>
          <dt>Džuma-namaz</dt>
          <dd>
            {dzamija.dzuma.vrijeme ? (
              <p><strong>{dzamija.dzuma.vrijeme}</strong>{dzamija.dzuma.napomena && <> — {dzamija.dzuma.napomena}</>}</p>
            ) : (
              <>
                <p>Petkom u vrijeme podne-namaza (u tabeli: <span class="badge">Džuma</span>).</p>
                {dzamija.dzuma.napomena ? <p class="muted">{dzamija.dzuma.napomena}</p> : <Placeholder label="tačno vrijeme hutbe i džume u džamiji" inline />}
              </>
            )}
          </dd>
        </div>
        <div>
          <dt>Tačnost</dt>
          <dd>
            <p>
              Vremena se računaju za {grad} po parametrima zvanične vaktije Islamske zajednice; odstupanje je
              moguće do <strong>±1–2 minute</strong>. Za ibadet se oslonite na zvaničnu vaktiju: <a href={izvor.url} target="_blank" rel="noopener">{izvor.naziv}</a>.
            </p>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--tint section--tight">
    <div class="container">
      <VaktijaMonth />
    </div>
  </section>
</BaseLayout>

<style>
  .vk { display: grid; gap: var(--space-6); }
  .vk__h2 { font-size: clamp(1.4rem, 1.1vw + 1.1rem, 1.75rem); margin: 0 0 var(--space-3); }
  .vk__info { margin: 0; border-top: 1px solid var(--color-border); }
  .vk__info > div {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-1) var(--space-4);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }
  @media (max-width: 560px) { .vk__info > div { grid-template-columns: 1fr; } }
  .vk__info dt { font-weight: 700; font-size: 0.9rem; color: var(--color-text-muted); }
  .vk__info dd { margin: 0; display: grid; gap: var(--space-2); font-size: 0.96rem; }
  .vk__info p { margin: 0; }
  @media print {
    .vk, :global(.page-hero) { display: none !important; }
  }
</style>
